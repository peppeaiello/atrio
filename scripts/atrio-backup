#!/bin/bash
# Backs up and restores one app at a time: its compose folder and the folders its containers use.
# Run by atrio-backup.path when Atrio writes a request through the CasaOS file API. Requests are
# "KEY=value" lines: only the known keys are read, their values are checked and never executed,
# and folders must be ones the app's containers really use.
set -uo pipefail

STATE="${ATRIO_STATE:-/var/lib/casaos/atrio}"
APPS="${ATRIO_APPS:-/var/lib/casaos/apps}"
APPDATA="${ATRIO_APPDATA:-/DATA/AppData}"
CASAOS_ENV="${ATRIO_CASAOS_ENV:-/etc/casaos/env}"
DEFAULT_DEST="${ATRIO_BACKUP_DEST:-$APPDATA/.atrio-backups}"
REQUEST="$STATE/backup-request"
STATUS="$STATE/backup-status.json"
CONF="$STATE/backup.conf"
# Signs every backup made here: a backup folder on a share or a cloud can be written by others,
# and a changed backup must never be restored as root
KEY="$STATE/backup.key"
INDEX="$STATE/backups"
# Folders used before: their backups stay listed, also while a disk is not connected
KNOWN="$STATE/backup-folders"
CACHE="$INDEX/.cache"
# Slow destinations get their archive from here, so that the app is not down during the transfer
STAGE="$DEFAULT_DEST/.staging"
# What a chosen folder gets inside it: its other files and its permissions stay as they are
SUBFOLDER="atrio-backups"
# Larger folders are left out unless chosen by hand
BIG="${ATRIO_BACKUP_BIG:-5368709120}"
# Backups made automatically, kept per app; the ones made by hand stay until deleted
KEEP_AUTO=3
HEALTH_WAIT="${ATRIO_HEALTH_WAIT:-60}"
HEALTH_STEADY="${ATRIO_HEALTH_STEADY:-20}"

ACTION="" APP="" ID="" REASON="manual" TOKEN="" DEST="$DEFAULT_DEST" DEST_MOUNT="" NEW_DEST="" FROM=""
# The folder new backups go to; DEST can be an older one for a restore or a delete
CONF_DEST="$DEFAULT_DEST"
CONF_MOUNT=""
STAGED=""
UPLOAD_TMP=""
CHOSEN=()
STOPPED=()
RUNNING_BEFORE=0
TMP_ARCHIVE=""

mkdir -p "$STATE" "$INDEX"
chmod 755 "$INDEX"

# One run at a time
exec 9>"$STATE/backup.lock"
flock -n 9 || exit 0

json() {
	printf '%s' "$1" | tr -d '\000-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# The web UI follows the operation through this file
write_status() {
	printf '{"state":"%s","action":"%s","app":"%s","id":"%s","step":"%s","message":"%s","token":"%s","time":"%s"}\n' \
		"$1" "$ACTION" "$APP" "$ID" "$2" "$(json "${3:-}")" "$TOKEN" "$(date -Iseconds)" > "$STATUS.tmp"
	mv "$STATUS.tmp" "$STATUS"
}

fail() {
	write_status error "" "$1"
	echo "$1" >&2
	exit 1
}

# --- Checks -----------------------------------------------------------------------------------

valid_path() {
	case "$1" in
		/*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*/../*|*/..|*/./*|*//*) return 1 ;;
	esac
	[ "$(printf '%s' "$1" | tr -d '\000-\037')" = "$1" ]
}

# Never touched: the system itself and folders that hold far more than one app
allowed_folder() {
	valid_path "$1" || return 1
	case "$1" in
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/var/run|/var/run/*|/etc|/etc/*) return 1 ;;
		/usr|/usr/*|/bin|/bin/*|/sbin|/sbin/*|/lib|/lib/*|/lib64|/lib64/*|/boot|/boot/*) return 1 ;;
		/var|/var/lib|/var/lib/docker|/var/lib/casaos|/home|/root|/media|/mnt|/opt|/srv) return 1 ;;
		"$APPDATA"|"$DEFAULT_DEST"|"$DEFAULT_DEST"/*) return 1 ;;
	esac
	# Top-level folders like /DATA
	[ "$(dirname "$1")" != "/" ]
}

read_request() {
	[ -f "$REQUEST" ] || exit 0
	local line key value
	while IFS= read -r line || [ -n "$line" ]; do
		line="${line%$'\r'}"
		key="${line%%=*}"
		value="${line#*=}"
		case "$key" in
			ACTION) ACTION="$value" ;;
			APP) APP="$value" ;;
			ID) ID="$value" ;;
			REASON) REASON="$value" ;;
			TOKEN) TOKEN=$(printf '%s' "$value" | head -c 64 | tr -cd 'A-Za-z0-9-') ;;
			FOLDER) CHOSEN+=("$value") ;;
			DEST) NEW_DEST="$value" ;;
			FROM) FROM="$value" ;;
		esac
	done < "$REQUEST"
	rm -f "$REQUEST"
	case "$ACTION" in
		scan|backup|restore|delete|destination|forget) ;;
		*) ACTION=""; APP=""; ID=""; fail "Unknown request" ;;
	esac
	if ! [[ "$APP" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
		APP=""
		fail "Unknown app"
	fi
	if [ -n "$ID" ] && ! [[ "$ID" =~ ^[0-9]{8}-[0-9]{6}(-[0-9])?$ ]]; then
		ID=""
		fail "Unknown backup"
	fi
	case "$REASON" in
		manual|before-update|before-restore) ;;
		*) REASON=manual ;;
	esac
}

allowed_dest() {
	valid_path "$1" && [ "$(dirname "$1")" != "/" ] || return 1
	case "$1" in
		/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*|/etc|/etc/*|/usr|/usr/*|/bin|/bin/*|/sbin|/sbin/*) return 1 ;;
		/lib|/lib/*|/lib64|/lib64/*|/boot|/boot/*|/tmp|/tmp/*|/root|/root/*) return 1 ;;
		/var/run|/var/run/*|/var/lib/docker|/var/lib/docker/*|/var/lib/casaos|/var/lib/casaos/*) return 1 ;;
		"$APPS"|"$APPS"/*|"$STATE"|"$STATE"/*) return 1 ;;
	esac
}

read_conf() {
	[ -f "$CONF" ] || return 0
	local value
	value=$(sed -n 's/^DEST=//p' "$CONF" | head -n 1)
	[ -n "$value" ] || return 0
	DEST_MOUNT=$(sed -n 's/^MOUNT=//p' "$CONF" | head -n 1)
	allowed_dest "$value" || fail "The backup folder is not valid"
	DEST="$value"
	CONF_DEST="$DEST"
	CONF_MOUNT="$DEST_MOUNT"
}

# "folder<tab>its disk", the default and the current one first
known_folders() {
	{
		printf '%s\t\n' "$DEFAULT_DEST"
		printf '%s\t%s\n' "$CONF_DEST" "$CONF_MOUNT"
		[ -f "$KNOWN" ] && cat "$KNOWN"
	} | awk -F'\t' '!seen[$1]++'
}

remember_folder() {
	[ "$1" = "$DEFAULT_DEST" ] && return 0
	printf '%s\t%s\n' "$1" "$2" >> "$KNOWN"
	awk -F'\t' '!seen[$1]++' "$KNOWN" > "$KNOWN.tmp" && mv "$KNOWN.tmp" "$KNOWN"
}

# A restore or a delete works where that backup is, and so does the copy saved before a restore
use_folder() {
	local path mount
	while IFS=$'\t' read -r path mount; do
		if [ "$path" = "$1" ]; then
			DEST="$path"
			DEST_MOUNT="$mount"
			return 0
		fi
	done < <(known_folders)
	return 1
}

mount_of() {
	timeout 20 findmnt -n -o TARGET --target "$1" 2>/dev/null | head -n 1
}

# A disk that is not plugged in leaves an ordinary empty folder behind: writing there would fill the
# main disk with backups that look safe, so the folder must still be on the disk it was chosen on.
dest_connected() {
	if [ -n "$DEST_MOUNT" ] && [ "$(mount_of "$DEST")" != "$DEST_MOUNT" ]; then
		return 1
	fi
	timeout 20 mkdir -p "$DEST" 2>/dev/null
}

require_dest() {
	dest_connected || fail "The backup folder is not connected: plug in the disk or reconnect the folder, or choose another one"
}

# Network folders and cloud drives; mergerfs is the local disks merged
dest_is_remote() {
	local type
	type=$(timeout 20 findmnt -n -o FSTYPE --target "$DEST" 2>/dev/null | head -n 1)
	case "$type" in
		fuse.mergerfs) return 1 ;;
		cifs|smb3|smbfs|nfs|nfs4|9p|fuse.*|fuse) return 0 ;;
	esac
	return 1
}

# Like dest_connected, for reading: an older folder is not created again
dest_present() {
	if [ -n "$DEST_MOUNT" ] && [ "$(mount_of "$DEST")" != "$DEST_MOUNT" ]; then
		return 1
	fi
	timeout 20 test -d "$DEST"
}

free_bytes() {
	timeout 20 df -B1 --output=avail "$1" 2>/dev/null | tail -n 1 | tr -d ' '
}

make_stage() {
	mkdir -p "$STAGE" || fail "Could not create the backup folder"
	chmod 700 "$DEFAULT_DEST" "$STAGE" 2>/dev/null
}

# --- Containers -------------------------------------------------------------------------------

container_ids() {
	docker ps -aq --filter "label=com.docker.compose.project=$APP" 2>/dev/null
}

running_ids() {
	docker ps -q --filter "label=com.docker.compose.project=$APP" 2>/dev/null
}

# CasaOS fills these in when it reads a compose file; most App Store apps have
# /DATA/AppData/$AppID/... as their folders, and without them they would start on an empty path.
compose_env() {
	local line zone
	zone=$(cat /etc/timezone 2>/dev/null)
	printf '%s\n' "AppID=$APP" "PUID=${PUID:-1000}" "PGID=${PGID:-1000}" "TZ=${zone:-UTC}"
	[ -f "$CASAOS_ENV" ] || return 0
	while IFS= read -r line; do
		[[ "$line" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && printf '%s\n' "$line"
	done < "$CASAOS_ENV"
}

compose() {
	local vars=()
	mapfile -t vars < <(compose_env)
	env "${vars[@]}" docker compose -p "$APP" --project-directory "$APPS/$APP" -f "$APPS/$APP/docker-compose.yml" "$@"
}

# Every host folder the containers use; docker knows them for bind mounts and named volumes alike
mounted_folders() {
	local ids
	ids=$(container_ids)
	[ -n "$ids" ] || return 0
	# shellcheck disable=SC2086
	docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' $ids 2>/dev/null | grep -v '^$' | sort -u
}

stop_app() {
	mapfile -t STOPPED < <(running_ids)
	[ "${#STOPPED[@]}" -gt 0 ] || return 0
	RUNNING_BEFORE=1
	write_status running stopping
	docker stop -t 60 "${STOPPED[@]}" >/dev/null || fail "Could not stop the app"
}

# Whatever happens, an app that was running does not stay stopped
start_again() {
	[ "${#STOPPED[@]}" -gt 0 ] || return 0
	write_status running starting
	compose start >/dev/null 2>&1 || docker start "${STOPPED[@]}" >/dev/null 2>&1
	STOPPED=()
}

on_exit() {
	local code=$?
	[ -n "$TMP_ARCHIVE" ] && rm -f "$TMP_ARCHIVE" "$TMP_ARCHIVE.info"
	[ -n "$UPLOAD_TMP" ] && timeout 60 rm -f "$UPLOAD_TMP"
	rm -rf "$STAGE"
	if [ "${#STOPPED[@]}" -gt 0 ]; then
		compose start >/dev/null 2>&1 || docker start "${STOPPED[@]}" >/dev/null 2>&1
	fi
	exit "$code"
}
trap on_exit EXIT

# running, or the reason it is not: the app has to stay up for HEALTH_STEADY seconds
app_health() {
	local waited=0 steady=0 ids line bad
	while [ "$waited" -lt "$HEALTH_WAIT" ]; do
		ids=$(container_ids)
		bad=""
		if [ -z "$ids" ]; then
			bad="no containers"
		else
			# shellcheck disable=SC2086
			while read -r line; do
				case "$line" in
					"running 0 "*|"exited 0 "*) ;;
					*) bad="$line" ;;
				esac
			done < <(docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{.RestartCount}}' $ids 2>/dev/null)
		fi
		if [ -z "$bad" ]; then
			steady=$((steady + 2))
			[ "$steady" -ge "$HEALTH_STEADY" ] && return 0
		else
			steady=0
		fi
		sleep 2
		waited=$((waited + 2))
	done
	return 1
}

# --- Listing ----------------------------------------------------------------------------------

folder_size() {
	local size
	size=$(timeout 120 du -sb "$1" 2>/dev/null | cut -f1)
	printf '%s' "${size:--1}"
}

# Folders the containers of other apps use, read once per run
OTHERS_READ=0
OTHERS=""
other_folders() {
	if [ "$OTHERS_READ" = 0 ]; then
		OTHERS_READ=1
		local ids
		ids=$(comm -23 <(docker ps -aq 2>/dev/null | sort) <(container_ids | sort))
		# shellcheck disable=SC2086
		[ -n "$ids" ] && OTHERS=$(docker inspect -f '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' $ids 2>/dev/null | grep -v '^$' | sort -u)
	fi
	return 0
}

# Used by another app too, or inside or around a folder it uses: restoring would change that app's data
is_shared() {
	local other
	other_folders
	while IFS= read -r other; do
		[ -n "$other" ] || continue
		case "$1/" in "$other"/*) return 0 ;; esac
		case "$other/" in "$1"/*) return 0 ;; esac
	done <<< "$OTHERS"
	return 1
}

own_folder() {
	is_shared "$1" && return 1
	case "$1" in
		"$APPDATA"/*|/var/lib/docker/volumes/*) return 0 ;;
	esac
	return 1
}

# Suggested: the app's own folders that are not huge
suggested() {
	[ "$2" -ge 0 ] && [ "$2" -le "$BIG" ] && own_folder "$1"
}

info_value() {
	sed -n "s/^$2=//p" "$1" | head -n 1
}

# Ids sort by time; without the extension, one made in the same second ("…-1") sorts after the first
backups_newest_first() {
	ls -1 "$DEST/$APP"/*.info 2>/dev/null | sed 's/\.info$//' | sort -r | sed 's/$/.info/'
}

cache_file() {
	printf '%s/%s/%s' "$CACHE" "$APP" "$(printf '%s' "$1" | md5sum | cut -d' ' -f1)"
}

# One line per backup in DEST: "id<tab>the rest of its json"
list_folder() {
	local info path inner
	while IFS= read -r info; do
		[ -n "$info" ] && [ -f "${info%.info}.tar.gz" ] || continue
		printf '%s\t"time":"%s","reason":"%s","size":%s,"bytes":%s,"images":"%s","folders":[' \
			"$(basename "${info%.info}")" "$(info_value "$info" TIME)" "$(info_value "$info" REASON)" \
			"$(stat -c %s "${info%.info}.tar.gz")" "$(info_value "$info" BYTES)" "$(json "$(info_value "$info" IMAGES)")"
		inner=1
		while IFS= read -r path; do
			[ "$inner" = 1 ] || printf ','
			inner=0
			printf '"%s"' "$(json "$path")"
		done < <(sed -n 's/^FOLDER=//p' "$info")
		printf ']}\n'
	done < <(backups_newest_first)
}

# The backups of this app in every known folder, newest first. A folder that is not connected
# shows what it held the last time it was seen.
all_backups() {
	local path mount cache available id rest
	while IFS=$'\t' read -r path mount; do
		DEST="$path"
		DEST_MOUNT="$mount"
		cache=$(cache_file "$path")
		available=false
		if dest_present; then
			available=true
			mkdir -p "$(dirname "$cache")"
			list_folder > "$cache.tmp" && mv "$cache.tmp" "$cache"
		fi
		[ -f "$cache" ] || continue
		while IFS=$'\t' read -r id rest; do
			[ -n "$id" ] && printf '%s\t{"id":"%s","dest":"%s","available":%s,%s\n' "$id" "$id" "$(json "$path")" "$available" "$rest"
		done < "$cache"
	done < <(known_folders)
	DEST="$CONF_DEST"
	DEST_MOUNT="$CONF_MOUNT"
}

write_index() {
	local out="$INDEX/$APP.json" first=1 path size selected remembered same_disk=false free=0 connected=false remote=false line
	DEST="$CONF_DEST"
	DEST_MOUNT="$CONF_MOUNT"
	if dest_connected; then
		connected=true
		free=$(free_bytes "$DEST")
		[ "$(df --output=source "$DEST" 2>/dev/null | tail -n 1)" = "$(df --output=source "$APPS" 2>/dev/null | tail -n 1)" ] && same_disk=true
		dest_is_remote && remote=true
	fi
	remembered="$INDEX/$APP.folders"
	{
		printf '{"app":"%s","dest":"%s","default_dest":"%s","connected":%s,"remote":%s,"same_disk":%s,"free":%s,"running":%s,"folders":[' \
			"$APP" "$(json "$DEST")" "$(json "$DEFAULT_DEST")" "$connected" "$remote" "$same_disk" "${free:-0}" "$([ -n "$(running_ids)" ] && echo true || echo false)"
		while IFS= read -r path; do
			[ -n "$path" ] || continue
			if allowed_folder "$path" && [ -e "$path" ]; then
				size=$(folder_size "$path")
				if [ -f "$remembered" ]; then
					grep -Fxq -- "$path" "$remembered" && selected=true || selected=false
				else
					suggested "$path" "$size" && selected=true || selected=false
				fi
				[ "$first" = 1 ] || printf ','
				first=0
				printf '{"path":"%s","size":%s,"selected":%s,"own":%s}' "$(json "$path")" "$size" "$selected" \
					"$(own_folder "$path" && echo true || echo false)"
			fi
		done < <(mounted_folders)
		printf '],"backups":['
		first=1
		while IFS= read -r line; do
			[ -n "$line" ] || continue
			[ "$first" = 1 ] || printf ','
			first=0
			printf '%s' "$line"
		done < <(all_backups | LC_ALL=C sort -r -t $'\t' -k1,1 | cut -f2-)
		printf ']}\n'
	} > "$out.tmp"
	chmod 644 "$out.tmp"
	mv "$out.tmp" "$out"
}

# --- Backup -----------------------------------------------------------------------------------

new_id() {
	local base id n=1
	base=$(date +%Y%m%d-%H%M%S)
	id="$base"
	while [ -e "$DEST/$APP/$id.tar.gz" ]; do
		id="$base-$n"
		n=$((n + 1))
	done
	printf '%s' "$id"
}

# Folders for this backup: those chosen and really used by the app, or the remembered or suggested ones
backup_folders() {
	local path size mounted
	mounted=$(mounted_folders)
	if [ "$REASON" = "manual" ]; then
		for path in ${CHOSEN[@]+"${CHOSEN[@]}"}; do
			if printf '%s\n' "$mounted" | grep -Fxq -- "$path" && allowed_folder "$path" && [ -e "$path" ]; then
				printf '%s\n' "$path"
			fi
		done
		return 0
	fi
	while IFS= read -r path; do
		[ -n "$path" ] && allowed_folder "$path" && [ -e "$path" ] || continue
		if [ -f "$INDEX/$APP.folders" ]; then
			grep -Fxq -- "$path" "$INDEX/$APP.folders" && printf '%s\n' "$path"
		else
			size=$(folder_size "$path")
			suggested "$path" "$size" && printf '%s\n' "$path"
		fi
	done <<< "$mounted"
}

prune_auto() {
	local info count=0
	while IFS= read -r info; do
		[ -n "$info" ] || continue
		[ "$(info_value "$info" REASON)" = "manual" ] && continue
		count=$((count + 1))
		[ "$count" -gt "$KEEP_AUTO" ] && rm -f "$info" "${info%.info}.tar.gz"
	done < <(backups_newest_first)
}

# Writes one backup of the app, stopped; start_again is up to the caller, then publish_archive.
# $1: reason, then the folders
make_archive() {
	local reason="$1" total=0 size path id archive work images ids free folder code
	shift
	mkdir -p "$DEST/$APP" || fail "Could not create the backup folder"
	chmod 700 "$DEST" "$DEST/$APP" 2>/dev/null

	total=$(folder_size "$APPS/$APP")
	for path in "$@"; do
		size=$(folder_size "$path")
		[ "$size" -gt 0 ] && total=$((total + size))
	done

	work="$DEST/$APP"
	if dest_is_remote; then
		make_stage
		work="$STAGE"
	fi
	free=$(free_bytes "$work")
	[ "${free:-0}" -gt "$total" ] || fail "Not enough free space in the backup folder"

	id=$(new_id)
	archive="$work/$id.tar.gz"
	TMP_ARCHIVE="$archive.tmp"
	ids=$(container_ids)
	images=""
	# shellcheck disable=SC2086
	[ -n "$ids" ] && images=$(docker inspect -f '{{.Config.Image}}' $ids 2>/dev/null | sort -u | paste -sd ' ')

	stop_app

	write_status running archiving
	local members=("${APPS#/}/$APP")
	for folder in "$@"; do
		members+=("${folder#/}")
	done
	tar --numeric-owner --xattrs --exclude="${DEST#/}" -czf "$TMP_ARCHIVE" -C / -- "${members[@]}" 2>/dev/null
	code=$?
	# 1: a file changed while reading, which a stopped app does not do to its own data
	[ "$code" -le 1 ] || fail "The backup could not be written: is there enough space?"

	{
		printf 'TIME=%s\nREASON=%s\nBYTES=%s\nIMAGES=%s\nRUNNING=%s\nSHA256=%s\n' \
			"$(date -Iseconds)" "$reason" "$total" "$images" "$RUNNING_BEFORE" "$(sha256sum "$TMP_ARCHIVE" | cut -d' ' -f1)"
		for folder in "$APPS/$APP" "$@"; do
			printf 'FOLDER=%s\n' "$folder"
		done
	} > "$TMP_ARCHIVE.info" || fail "The backup could not be written: is there enough space?"
	printf 'MAC=%s\n' "$(info_mac "$TMP_ARCHIVE.info")" >> "$TMP_ARCHIVE.info" || fail "The backup could not be written: is there enough space?"
	chmod 600 "$TMP_ARCHIVE" "$TMP_ARCHIVE.info"
	mv "$TMP_ARCHIVE.info" "$archive.info.tmp"
	mv "$TMP_ARCHIVE" "$archive"
	TMP_ARCHIVE=""
	LAST_ID="$id"
	if [ "$work" = "$STAGE" ]; then
		STAGED="$archive"
	else
		mv "$archive.info.tmp" "$work/$id.info"
	fi
}

# A slow destination gets the archive now; it only counts once the copy there reads back the same.
publish_archive() {
	[ -n "$STAGED" ] || return 0
	local id free size final="$DEST/$APP" info="$STAGED.info.tmp"
	id=$(basename "$STAGED" .tar.gz)
	write_status running uploading
	size=$(stat -c %s "$STAGED")
	free=$(free_bytes "$DEST")
	# Some cloud drives do not tell: then the copy itself finds out
	if [ "${free:-0}" -gt 0 ] && [ "$free" -le "$size" ]; then
		fail "Not enough free space in the backup folder"
	fi
	UPLOAD_TMP="$final/$id.tar.gz.tmp"
	cp --no-preserve=all "$STAGED" "$UPLOAD_TMP" || fail "The backup could not be copied to the backup folder"
	[ "$(sha256sum "$UPLOAD_TMP" | cut -d' ' -f1)" = "$(sha256sum "$STAGED" | cut -d' ' -f1)" ] \
		|| fail "The backup could not be copied to the backup folder"
	mv "$UPLOAD_TMP" "$final/$id.tar.gz" || fail "The backup could not be copied to the backup folder"
	UPLOAD_TMP="$final/$id.info.tmp"
	cp --no-preserve=all "$info" "$UPLOAD_TMP" && mv "$UPLOAD_TMP" "$final/$id.info" \
		|| fail "The backup could not be copied to the backup folder"
	UPLOAD_TMP=""
	rm -f "$STAGED" "$info"
	STAGED=""
}

do_backup() {
	local folders=()
	[ -f "$APPS/$APP/docker-compose.yml" ] || fail "Unknown app"
	require_dest
	mapfile -t folders < <(backup_folders)
	# What was chosen by hand is what automatic backups of this app will save too
	if [ "$REASON" = "manual" ]; then
		printf '%s\n' ${folders[@]+"${folders[@]}"} > "$INDEX/$APP.folders"
	fi
	make_archive "$REASON" ${folders[@]+"${folders[@]}"}
	ID="$LAST_ID"
	start_again
	publish_archive
	prune_auto
	write_index
	write_status done "" ""
}

# --- Signatures and archive checks -----------------------------------------------------------

backup_key() {
	if ! [ -s "$KEY" ]; then
		(umask 077 && head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1 > "$KEY.tmp" && mv "$KEY.tmp" "$KEY") \
			|| fail "Could not create the backup key"
	fi
	cat "$KEY"
}

# A keyed hash of the .info file, which holds the archive's SHA-256, the folders and the reason:
# the key on both sides, so nothing can be appended to a signed file
info_mac() {
	local key
	key=$(backup_key) || return 1
	{ printf '%s\n' "$key"; grep -v '^MAC=' "$1"; printf '%s\n' "$key"; } | sha256sum | cut -d' ' -f1
}

# Every member of the archive must sit inside the folders of the backup: no absolute paths, no "..",
# no device files, no hard link to a file elsewhere, nothing written through a symbolic link.
# $1: archive, then the folders without their leading slash
archive_is_safe() {
	local archive="$1" list
	shift
	list=$(LC_ALL=C tar --quoting-style=literal -tvzf "$archive" 2>/dev/null) || return 1
	printf '%s\n' "$list" | LC_ALL=C awk -v prefixes="$(printf '%s\n' "$@")" '
		function inside(path,   i) {
			if (path == "" || path ~ /^\// || path ~ /(^|\/)\.\.(\/|$)/) return 0
			for (i = 1; i <= n; i++) if (p[i] != "" && (path == p[i] || index(path, p[i] "/") == 1)) return 1
			return 0
		}
		BEGIN { n = split(prefixes, p, "\n"); bad = 0; links = 0; count = 0 }
		{
			# A line that is not a listing entry comes from a name with a line break in it
			if ($0 !~ /^[-dlhp][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT][-rwxsStT]/) { bad = 1; next }
			type = substr($0, 1, 1)
			name = $0
			sub(/^[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ +[^ ]+ /, "", name)
			if (type == "l") {
				at = index(name, " -> "); if (!at) { bad = 1; next }
				name = substr(name, 1, at - 1)
				links++; link[links] = name
			}
			if (type == "h") {
				at = index(name, " link to "); if (!at) { bad = 1; next }
				target = substr(name, at + 9); name = substr(name, 1, at - 1)
				if (!inside(target)) bad = 1
			}
			sub(/\/$/, "", name)
			if (!inside(name)) bad = 1
			count++; member[count] = name
		}
		END {
			for (i = 1; i <= count; i++) for (j = 1; j <= links; j++)
				if (index(member[i], link[j] "/") == 1) bad = 1
			exit bad
		}'
}

# --- Restore ----------------------------------------------------------------------------------

do_restore() {
	local info="$DEST/$APP/$ID.info" archive="$DEST/$APP/$ID.tar.gz" folders=() path current=() swapped=() compose_dir="$APPS/$APP"
	require_dest
	[ -n "$ID" ] && [ -f "$info" ] && [ -f "$archive" ] || fail "Unknown backup"
	# Everything is checked on a local copy, so that nothing can change between the check and its use
	make_stage
	cp --no-preserve=all "$info" "$STAGE/restore-$ID.info" || fail "The backup could not be read from the backup folder"
	info="$STAGE/restore-$ID.info"
	if [ -n "$(info_value "$info" MAC)" ]; then
		[ "$(info_value "$info" MAC)" = "$(info_mac "$info")" ] \
			|| fail "This backup was changed after it was made, or made on another server, and was not restored"
	elif [ "$DEST" != "$DEFAULT_DEST" ]; then
		# Made before backups were signed: only the default folder, which only root can write, is trusted
		fail "This backup was made by an older Atrio: it can only be restored from the default backup folder"
	fi
	# Read over the network only once, with the app still running
	if dest_is_remote; then
		write_status running downloading
		make_stage
		[ "$(free_bytes "$STAGE")" -gt "$(stat -c %s "$archive")" ] || fail "Not enough free space to restore this backup"
		cp --no-preserve=all "$archive" "$STAGE/restore-$ID.tar.gz" || fail "The backup could not be read from the backup folder"
		archive="$STAGE/restore-$ID.tar.gz"
	fi
	write_status running checking
	[ "$(sha256sum "$archive" | cut -d' ' -f1)" = "$(info_value "$info" SHA256)" ] || fail "This backup is damaged and was not restored"

	mapfile -t folders < <(sed -n 's/^FOLDER=//p' "$info")
	for path in "${folders[@]}"; do
		[ "$path" = "$compose_dir" ] && continue
		allowed_folder "$path" || fail "This backup contains a folder Atrio does not restore"
		# Swapping that folder would take the backups with it
		case "$DEST/" in
			"$path"/*) fail "The backup folder is inside a folder of this app: choose another one" ;;
		esac
		current+=("$path")
	done
	local prefixes=()
	for path in "${folders[@]}"; do
		prefixes+=("${path#/}")
	done
	archive_is_safe "$archive" "${prefixes[@]}" || fail "This backup contains files outside the folders of this app and was not restored"

	local free
	free=$(df -B1 --output=avail "$APPS" | tail -n 1 | tr -d ' ')
	[ "${free:-0}" -gt "$(info_value "$info" BYTES)" ] || fail "Not enough free space to restore this backup"

	# The current state first, so that this restore can be undone too
	if [ -f "$compose_dir/docker-compose.yml" ]; then
		make_archive before-restore ${current[@]+"${current[@]}"}
		# Nothing changes until the copy to go back to is safe where it belongs
		publish_archive
	fi

	write_status running restoring
	local suffix=".atrio-old-$ID"
	undo_swap() {
		local item
		for item in ${swapped[@]+"${swapped[@]}"}; do
			rm -rf "$item"
			mv "$item$suffix" "$item"
		done
	}
	for path in "${folders[@]}"; do
		if [ -e "$path" ]; then
			rm -rf "$path$suffix"
			if ! mv "$path" "$path$suffix"; then
				undo_swap
				fail "The backup could not be restored, nothing was changed"
			fi
			swapped+=("$path")
		fi
	done
	local code=0
	tar --numeric-owner --xattrs -xzpf "$archive" -C / 2>/dev/null || code=$?
	if [ "$code" -gt 1 ]; then
		undo_swap
		fail "The backup could not be restored, nothing was changed"
	fi
	for path in ${swapped[@]+"${swapped[@]}"}; do
		rm -rf "$path$suffix"
	done

	# With the restored compose file: its image may be another version
	STOPPED=()
	write_status running starting
	if [ "$RUNNING_BEFORE" = 1 ] || [ "$(info_value "$info" RUNNING)" = 1 ]; then
		compose up -d >/dev/null 2>&1 || fail "The files are back, but the app did not start: check it in its panel"
		# An app can run fine on a wrong, empty folder: it must be using the ones just restored
		local mounted
		mounted=$(mounted_folders)
		for path in ${current[@]+"${current[@]}"}; do
			printf '%s\n' "$mounted" | grep -Fxq -- "$path" || fail "The files are back, but the app started without them: open its settings and save them to start it again"
		done
		write_status running checking
		app_health || fail "The files are back, but the app is not running properly: check its logs"
	fi
	prune_auto
	write_index
	write_status done "" ""
}

do_delete() {
	require_dest
	[ -n "$ID" ] && [ -f "$DEST/$APP/$ID.tar.gz" ] || fail "Unknown backup"
	rm -f "$DEST/$APP/$ID.tar.gz" "$DEST/$APP/$ID.info"
	rmdir "$DEST/$APP" 2>/dev/null
	write_index
	write_status done "" ""
}

# --- Destination ------------------------------------------------------------------------------

# Empty means back to the default. Checked for real before anything is saved.
do_destination() {
	local chosen="$NEW_DEST" mount
	if [ -z "$chosen" ]; then
		remember_folder "$CONF_DEST" "$CONF_MOUNT"
		rm -f "$CONF"
		CONF_DEST="$DEFAULT_DEST"
		CONF_MOUNT=""
		write_index
		write_status done "" ""
		return 0
	fi
	chosen="${chosen%/}"
	[ -n "$chosen" ] || chosen="/"
	if [ "$chosen" != "$DEFAULT_DEST" ] && [ "$(basename "$chosen")" != "$SUBFOLDER" ]; then
		chosen="${chosen%/}/$SUBFOLDER"
	fi
	allowed_dest "$chosen" || fail "This folder cannot hold backups: choose another one"
	timeout 60 mkdir -p "$chosen" 2>/dev/null || fail "Atrio cannot write in this folder: choose another one"
	if ! { timeout 60 touch "$chosen/.atrio-write-test" 2>/dev/null && timeout 60 rm -f "$chosen/.atrio-write-test"; }; then
		fail "Atrio cannot write in this folder: choose another one"
	fi
	mount=$(mount_of "$chosen")
	[ -n "$mount" ] || fail "Atrio cannot write in this folder: choose another one"
	remember_folder "$CONF_DEST" "$CONF_MOUNT"
	printf 'DEST=%s\nMOUNT=%s\n' "$chosen" "$mount" > "$CONF.tmp"
	mv "$CONF.tmp" "$CONF"
	CONF_DEST="$chosen"
	CONF_MOUNT="$mount"
	write_index
	write_status done "" ""
}

# Takes an old folder off the list, for a disk that is gone. Nothing on it is deleted.
do_forget() {
	local name
	if [ -z "$FROM" ] || [ "$FROM" = "$DEFAULT_DEST" ] || [ "$FROM" = "$CONF_DEST" ] || ! use_folder "$FROM"; then
		fail "Unknown folder"
	fi
	if [ -f "$KNOWN" ]; then
		awk -F'\t' -v path="$(printf '%s' "$FROM" | sed 's/\\/\\\\/g')" '$1 != path' "$KNOWN" > "$KNOWN.tmp" && mv "$KNOWN.tmp" "$KNOWN"
	fi
	name=$(basename "$(cache_file "$FROM")")
	rm -f "$CACHE"/*/"$name"
	write_index
	write_status done "" ""
}

# --- Main -------------------------------------------------------------------------------------

# install.sh runs this once: the status file is how the web UI knows the service is there
if [ "${1:-}" = "--init" ]; then
	[ -f "$STATUS" ] || write_status idle "" ""
	exit 0
fi

read_request
read_conf
rm -rf "$STAGE"
case "$ACTION" in
	restore|delete)
		if [ -n "$FROM" ]; then
			use_folder "$FROM" || fail "Unknown backup"
		fi
		;;
esac
command -v docker >/dev/null || fail "Docker is not available"
docker compose version >/dev/null 2>&1 || fail "Docker Compose is not available"

case "$ACTION" in
	scan)
		write_status running scanning
		write_index
		write_status done "" ""
		;;
	backup) write_status running preparing; do_backup ;;
	restore) do_restore ;;
	delete) do_delete ;;
	destination) do_destination ;;
	forget) do_forget ;;
esac
