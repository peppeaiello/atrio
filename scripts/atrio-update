#!/bin/bash
# Installs the latest Atrio release from GitHub into the CasaOS web UI folder.
# Run by atrio-update.service when Atrio asks for an update (it writes the request file
# through the CasaOS file API), by atrio-restore.service when a CasaOS update puts its own UI
# back (--restore), or by hand: sudo atrio-update [--force]
set -euo pipefail

REPO="peppeaiello/atrio"
WWW="/var/lib/casaos/www"
STATE="/var/lib/casaos/atrio"
STATUS="$STATE/update-status.json"
REQUEST="$STATE/update-request"
BACKUP="$STATE/casaos-ui-original"
# The last installed release, used to restore Atrio when GitHub cannot be reached
LOCAL="$STATE/release"
DOWNLOAD="${ATRIO_DOWNLOAD:-https://github.com/$REPO/releases/latest/download}"
# Releases are signed on the maintainer's machine, with a key GitHub never sees: a release that
# someone else uploaded, even with access to the GitHub account, is not installed
KEYRING="${ATRIO_RELEASE_KEY:-/usr/local/share/atrio/release-key.gpg}"
# The release whose services (this updater, push alerts, backups) are installed, see update_server
SERVER_VERSION="$STATE/server-version"
MODE="${1:-}"

mkdir -p "$STATE"

if [ "$MODE" = "--restore" ]; then
	# A CasaOS update writes its UI file by file: let it finish before looking
	sleep "${ATRIO_RESTORE_DELAY:-30}"
	if [ ! -f "$WWW/index.html" ] || grep -q "Atrio" "$WWW/index.html"; then
		exit 0
	fi
	echo "The CasaOS UI came back (CasaOS update?): putting Atrio back"
fi

# One run at a time (the path unit and a manual run could overlap)
exec 9>"$STATE/lock"
if ! flock -n 9; then
	echo "Another Atrio update is running" >&2
	exit 0
fi

# The request may carry a token that the web UI uses to recognise this run's status
TOKEN=""
if [ -f "$REQUEST" ]; then
	TOKEN=$(head -c 64 "$REQUEST" | tr -cd 'A-Za-z0-9-')
	rm -f "$REQUEST"
fi

installed_version() {
	sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$1/atrio-version.json" 2>/dev/null || true
}

# Activity log, read by the web UI: "time<tab>action<tab>ok|error<tab>app<tab>detail", newest last
log_activity() {
	local line
	line=$(printf '%s\t%s\t%s\t%s\t%s' "$(date -Iseconds)" "$1" "$2" "$3" "$4" | tr -d '\000-\010\012-\037' | head -c 600)
	printf '%s\n' "$line" >> "$STATE/activity.log" 2>/dev/null
	chmod 644 "$STATE/activity.log" 2>/dev/null
}

# The web UI reads this file to follow the update
write_status() {
	printf '{"state":"%s","version":"%s","message":"%s","token":"%s","time":"%s"}\n' \
		"$1" "$(installed_version "$WWW")" "$2" "$TOKEN" "$(date -Iseconds)" > "$STATUS.tmp"
	mv "$STATUS.tmp" "$STATUS"
	# Run by hand (install.sh), each step shows in the terminal too
	if [ "$1" = running ] && [ -t 2 ]; then
		echo "$2..." >&2
	fi
}

fail() {
	write_status error "$1"
	echo "$1" >&2
	exit 1
}

TMP=$(mktemp -d)
trap 'rm -rf "$TMP" "$WWW.new"' EXIT
trap 'write_status error "The update failed, Atrio was not changed"' ERR

if [ "$MODE" = "--restore" ]; then
	# The UI that CasaOS just put back is its newest one: keep it for uninstall.sh
	rm -rf "$BACKUP.tmp"
	cp -a "$WWW" "$BACKUP.tmp"
	rm -f "$BACKUP.tmp/atrio-version.json"
	rm -rf "$BACKUP"
	mv "$BACKUP.tmp" "$BACKUP"
fi

download() {
	local CURL=(curl -fsSL --connect-timeout 20 --max-time 300 --retry 2)
	# A progress bar for the large file when a person is watching, nothing in the journal otherwise
	local BIG=("${CURL[@]}")
	if [ -t 2 ]; then
		BIG=(curl -fSL --progress-bar --connect-timeout 20 --max-time 300 --retry 2)
	fi
	"${BIG[@]}" -o "$TMP/atrio.tar.gz" "$DOWNLOAD/atrio.tar.gz" &&
		"${CURL[@]}" -o "$TMP/atrio.tar.gz.sha256" "$DOWNLOAD/atrio.tar.gz.sha256" || return 1
	# A release without a signature is refused below, with its own message
	if [ -f "$KEYRING" ]; then
		"${CURL[@]}" -o "$TMP/atrio.tar.gz.sig" "$DOWNLOAD/atrio.tar.gz.sig" 2>/dev/null || rm -f "$TMP/atrio.tar.gz.sig"
	fi
}

# Installs without the key (set up before signed releases) keep checking the SHA-256 only
signed() {
	[ -f "$KEYRING" ] || return 0
	command -v gpgv >/dev/null && [ -f "$1/atrio.tar.gz.sig" ] &&
		gpgv --keyring "$KEYRING" "$1/atrio.tar.gz.sig" "$1/atrio.tar.gz" >/dev/null 2>&1
}

# The services of the release, from its own signed bundle, installed by its own atrio-setup: updating
# from the settings brings them too, not only the web UI. Only for installs that have the release key.
update_server() {
	[ -f "$KEYRING" ] && command -v gpgv >/dev/null || return 0
	# install.sh trying the services of a checkout (ATRIO_SOURCE): keep them
	[ -n "${ATRIO_KEEP_SERVER:-}" ] && return 0
	# install.sh has just set them up from this same release
	[ "$(cat "$SERVER_VERSION" 2>/dev/null)" = "$1" ] && return 0
	write_status running "Updating the services on the server"
	local CURL=(curl -fsSL --connect-timeout 20 --max-time 300 --retry 2)
	"${CURL[@]}" -o "$TMP/atrio-server.tar.gz" "$DOWNLOAD/atrio-server.tar.gz" 2>/dev/null &&
		"${CURL[@]}" -o "$TMP/atrio-server.tar.gz.sig" "$DOWNLOAD/atrio-server.tar.gz.sig" 2>/dev/null || return 1
	gpgv --keyring "$KEYRING" "$TMP/atrio-server.tar.gz.sig" "$TMP/atrio-server.tar.gz" >/dev/null 2>&1 || return 1
	rm -rf "$TMP/server"
	mkdir "$TMP/server"
	tar -xzf "$TMP/atrio-server.tar.gz" -C "$TMP/server" --no-same-owner --no-same-permissions || return 1
	[ -z "$(find "$TMP/server" -mindepth 1 ! -type f)" ] && [ -f "$TMP/server/atrio-setup" ] || return 1
	bash "$TMP/server/atrio-setup" "$TMP/server" --update || return 1
	echo "$1" > "$SERVER_VERSION"
}

use_local_copy() {
	rm -f "$TMP/atrio.tar.gz" "$TMP/atrio.tar.gz.sha256" "$TMP/atrio.tar.gz.sig"
	cp "$LOCAL/atrio.tar.gz" "$LOCAL/atrio.tar.gz.sha256" "$TMP/"
	if [ -f "$LOCAL/atrio.tar.gz.sig" ]; then
		cp "$LOCAL/atrio.tar.gz.sig" "$TMP/"
	fi
}

write_status running "Downloading the latest release"
if ! download; then
	if [ "$MODE" = "--restore" ] && [ -f "$LOCAL/atrio.tar.gz" ]; then
		echo "GitHub cannot be reached: restoring the last installed release"
		use_local_copy
	else
		fail "Could not download the release from GitHub, Atrio was not changed"
	fi
fi
write_status running "Checking the signature"
(cd "$TMP" && sha256sum -c atrio.tar.gz.sha256 >/dev/null)
if ! signed "$TMP"; then
	# The copy kept here was checked when it was installed, and only root can write it
	if [ "$MODE" = "--restore" ] && [ -f "$LOCAL/atrio.tar.gz" ]; then
		echo "The release on GitHub is not signed by Atrio: restoring the last installed release"
		use_local_copy
		(cd "$TMP" && sha256sum -c atrio.tar.gz.sha256 >/dev/null)
	else
		fail "The release on GitHub is not signed by Atrio, so it was not installed"
	fi
fi

mkdir "$TMP/www"
tar -xzf "$TMP/atrio.tar.gz" -C "$TMP/www" --no-same-owner --no-same-permissions
if [ -n "$(find "$TMP/www" ! -type f ! -type d)" ]; then
	fail "The downloaded release contains unexpected files"
fi
if [ ! -f "$TMP/www/index.html" ] || [ ! -f "$TMP/www/atrio-version.json" ]; then
	fail "The downloaded release is not a valid Atrio build"
fi

latest=$(installed_version "$TMP/www")
# A CasaOS update can leave our atrio-version.json behind, so --restore always installs
if [ "$latest" = "$(installed_version "$WWW")" ] && [ -z "$MODE" ]; then
	# The web UI is current; the services may not be, after a failed try or an older updater
	if [ "$(cat "$SERVER_VERSION" 2>/dev/null)" != "$latest" ] && [ -f "$KEYRING" ]; then
		update_server "$latest" || fail "Atrio $latest is installed, but the services on the server could not be updated"
	fi
	write_status done "Atrio $latest is already installed"
	exit 0
fi

write_status running "Installing Atrio $latest"

# Keep the previous build's assets for a while: browsers that still have the old index.html
# cached (the CasaOS gateway answers 304 to it) can load, then reload into the new version.
if [ -d "$WWW/assets" ]; then
	cp -a -n "$WWW/assets/." "$TMP/www/assets/" 2>/dev/null || true
	find "$TMP/www/assets" -type f -mtime +30 -delete
fi
# The user's own customisations survive updates
for file in js/custom.js css/custom.css; do
	if [ -f "$WWW/$file" ]; then
		cp -a "$WWW/$file" "$TMP/www/$file"
	fi
done

# Stage next to the live folder (same filesystem), then swap with two renames and a rollback,
# so the UI is never half old and half new
rm -rf "$WWW.new" "$WWW.old"
cp -a "$TMP/www" "$WWW.new" || fail "Not enough space to install Atrio $latest, Atrio was not changed"
chown -R root:root "$WWW.new"
chmod 755 "$WWW.new"
mv "$WWW" "$WWW.old" || fail "Could not replace the web UI folder, Atrio was not changed"
if ! mv "$WWW.new" "$WWW"; then
	mv "$WWW.old" "$WWW"
	fail "Could not replace the web UI folder, Atrio was not changed"
fi
rm -rf "$WWW.old"

mkdir -p "$LOCAL"
rm -f "$LOCAL/atrio.tar.gz.sig"
cp "$TMP/atrio.tar.gz" "$TMP/atrio.tar.gz.sha256" "$LOCAL/"
if [ -f "$TMP/atrio.tar.gz.sig" ]; then
	cp "$TMP/atrio.tar.gz.sig" "$LOCAL/"
fi

# A restore after a CasaOS update only puts the web UI back: the services were not touched
DONE="Atrio $latest installed"
if [ "$MODE" != "--restore" ] && ! update_server "$latest"; then
	DONE="Atrio $latest installed, but the services on the server could not be updated: run the install command once more"
fi

# The gateway dates every file with its own start time, so browsers that revalidate their cached
# index.html get 304 forever. A restart gives a new date and every browser loads the new version.
# Done before reporting "done", so the web UI only reloads once the gateway is back.
write_status running "Restarting the CasaOS gateway"
systemctl try-restart casaos-gateway.service 2>/dev/null || true
sleep 3

write_status done "$DONE"
log_activity atrio-update ok "" "$latest"
echo "$DONE"
