#!/bin/bash
# Sends Atrio's warnings to a phone through ntfy, Gotify or Apprise, even when no browser has Atrio open.
# Run every 5 minutes by atrio-alerts.timer, and with --test by atrio-alerts-test.path when the
# settings ask for a test message. The settings are in alerts.conf, written by Atrio through the
# CasaOS file API: only the known keys are read, and their values are checked, never executed.
set -uo pipefail

STATE="${ATRIO_STATE:-/var/lib/casaos/atrio}"
CONF="$STATE/alerts.conf"
MEMORY="$STATE/alerts-memory"
STATUS="$STATE/alerts-status.json"
TEST_REQUEST="$STATE/alerts-test"
APPS="${ATRIO_APPS:-/var/lib/casaos/apps}"
WWW="${ATRIO_WWW:-/var/lib/casaos/www}"
SYS="${ATRIO_SYS:-/sys}"
PROC="${ATRIO_PROC:-/proc}"
REPO="peppeaiello/atrio"
MODE="${1:-}"

mkdir -p "$STATE"
# The settings hold the token of the push service: root only. Atrio reads and writes them as root too.
[ -f "$CONF" ] && chmod 600 "$CONF"

# One run at a time: the timer and a test could overlap
exec 9>"$STATE/alerts.lock"
# A run on the timer can take a while (disks waking up, docker stats): what the web UI asks for waits
# longer for it, and says so when it could not run (75), instead of looking done
case "$MODE" in
	--network | --disk-test) flock -w "${ATRIO_LOCK_WAIT:-90}" 9 || exit 75 ;;
	*) flock -w 30 9 || exit 0 ;;
esac

# --- Settings ---------------------------------------------------------------------------------

ENABLED=0 SERVICE=ntfy URL="https://ntfy.sh" TOPIC="" TOKEN="" LANGUAGE=en
DISK=1 HEALTH=1 TEMP=1 APPS_CHANGES=1 APP_UPDATES=1 UPDATES=1 APP_DOWN=1 DISK_LIMIT=90 TEMP_LIMIT=85
# Quiet hours hold back what is not urgent until they end; muted apps send nothing (their changes are still logged)
QUIET=0 QUIET_FROM=23:00 QUIET_TO=07:00 MUTE=""
# Scheduled SMART self-tests of the disks (they run inside the disk, also with alerts off)
SELFTEST=1
QUEUE="$STATE/alerts-queue"

read_conf() {
	[ -f "$CONF" ] || return 0
	local key value
	while IFS='=' read -r key value; do
		value="${value%$'\r'}"
		case "$key" in
			ENABLED | DISK | HEALTH | TEMP | APPS | APP_UPDATES | UPDATES | APP_DOWN | QUIET | SELFTEST)
				[[ "$value" =~ ^[01]$ ]] || continue
				[ "$key" = APPS ] && key=APPS_CHANGES
				printf -v "$key" '%s' "$value" ;;
			SERVICE) [[ "$value" =~ ^(ntfy|gotify|apprise)$ ]] && SERVICE="$value" ;;
			URL) [[ "$value" =~ ^https?://[A-Za-z0-9.:/_~%-]+$ ]] && URL="${value%/}" ;;
			TOPIC) [[ "$value" =~ ^[A-Za-z0-9_-]{1,64}$ ]] && TOPIC="$value" ;;
			TOKEN) [[ "$value" =~ ^[A-Za-z0-9._-]{0,128}$ ]] && TOKEN="$value" ;;
			LANGUAGE) [[ "$value" =~ ^(en|it)$ ]] && LANGUAGE="$value" ;;
			DISK_LIMIT) [[ "$value" =~ ^[5-9][0-9]$ ]] && DISK_LIMIT="$value" ;;
			TEMP_LIMIT) [[ "$value" =~ ^([6-9][0-9]|10[0-9]|110)$ ]] && TEMP_LIMIT="$value" ;;
			QUIET_FROM | QUIET_TO) [[ "$value" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && printf -v "$key" '%s' "$value" ;;
			MUTE) [[ "$value" =~ ^[A-Za-z0-9_.,-]{0,2000}$ ]] && MUTE="$value" ;;
		esac
	done < "$CONF"
}

# --- What was already sent (key=value lines) -------------------------------------------------

# Keys hold app names, compared as plain text: in a regular expression "a.b" would also match "aXb"
memory_get() {
	key="$1=" awk 'index($0, ENVIRON["key"]) == 1 { print substr($0, length(ENVIRON["key"]) + 1); exit }' "$MEMORY" 2>/dev/null
}

memory_set() {
	{ key="$1=" awk 'index($0, ENVIRON["key"]) != 1' "$MEMORY" 2>/dev/null; printf '%s=%s\n' "$1" "$2"; } > "$MEMORY.tmp"
	mv "$MEMORY.tmp" "$MEMORY"
}

# Activity log, read by the web UI: "time<tab>action<tab>ok|error<tab>app<tab>detail", newest last
log_activity() {
	local line
	line=$(printf '%s\t%s\t%s\t%s\t%s' "$(date -Iseconds)" "$1" "$2" "$3" "$4" | tr -d '\000-\010\012-\037' | head -c 600)
	printf '%s\n' "$line" >> "$STATE/activity.log" 2>/dev/null
	chmod 644 "$STATE/activity.log" 2>/dev/null
}

# atrio-backup logs the updates it makes itself; the image change it leaves is the same update
recently_updated_here() {
	local since
	since=$(date -d '-30 min' +%s)
	tail -n 200 "$STATE/activity.log" 2>/dev/null | awk -F'\t' -v app="$1" -v since="$since" '
		($2 == "update-app" || $2 == "auto-update") && $3 == "ok" && $4 == app { cmd = "date -d \"" $1 "\" +%s"; cmd | getline t; close(cmd); if (t >= since) found = 1 }
		END { exit !found }'
}

# Keeps the activity log to its last 1500 events
trim_activity() {
	local file="$STATE/activity.log"
	[ -f "$file" ] && [ "$(wc -l < "$file")" -gt 2000 ] || return 0
	tail -n 1500 "$file" > "$file.tmp" && chmod 644 "$file.tmp" && mv "$file.tmp" "$file"
}

# --- Messages ----------------------------------------------------------------------------------

text() {
	local id="$1"; shift
	if [ "$LANGUAGE" = it ]; then
		case "$id" in
			test_title) echo "Notifica di prova di Atrio" ;;
			test_body) echo "Se leggi questo messaggio, gli avvisi push funzionano." ;;
			disk_title) echo "Disco quasi pieno" ;;
			disk_body) echo "$1 è pieno al $2%. Libera spazio perché app e CasaOS continuino a funzionare." ;;
			health_title) echo "Problema di salute di un disco" ;;
			disk_watch) echo "Il disco $1 mostra i primi segni di problemi: tienilo d'occhio e controlla di avere i backup." ;;
			disk_replace) echo "Il disco $1 rischia di guastarsi presto: fai subito un backup dei dati e pensa a sostituirlo." ;;
			health_body) echo "Il disco $1 segnala un problema (SMART). Fai un backup dei dati e controlla il disco." ;;
			temp_title) echo "Processore caldo" ;;
			temp_body) echo "Il processore è a $1 °C. Controlla il raffreddamento e cosa sta girando." ;;
			installed_title) echo "App installata" ;;
			installed_body) echo "$1 è installata." ;;
			removed_title) echo "App rimossa" ;;
			removed_body) echo "$1 è stata rimossa." ;;
			app_updated_title) echo "App aggiornata" ;;
			app_updated_body) echo "$1 è stata aggiornata." ;;
			queue_title) echo "Durante le ore di silenzio" ;;
			queue_more) echo "… e altri $1." ;;
			down_title) echo "App non funzionante" ;;
			down_restarting) echo "$1 continua a riavviarsi." ;;
			down_crashed) echo "$1 si è fermata da sola (codice $2)." ;;
			down_unhealthy) echo "$1 segnala di non stare bene (controllo di salute)." ;;
			down_no_answer) echo "$1 è avviata ma la sua pagina non risponde." ;;
			up_title) echo "App di nuovo attiva" ;;
			up_body) echo "$1 funziona di nuovo." ;;
			backup_title) echo "Backup automatico non riuscito" ;;
			backup_body) echo "Il backup automatico di $1 non è riuscito: $2" ;;
			auto_update_title) echo "Aggiornamento automatico non riuscito" ;;
			auto_update_body) echo "$1 non è stata aggiornata in automatico: $2" ;;
			update_title) echo "Nuova versione di Atrio" ;;
			update_body) echo "È disponibile Atrio $1. Apri le impostazioni di Atrio per aggiornare." ;;
		esac
	else
		case "$id" in
			test_title) echo "Atrio test notification" ;;
			test_body) echo "If you can read this, push alerts work." ;;
			disk_title) echo "Disk almost full" ;;
			disk_body) echo "$1 is $2% full. Free some space to keep apps and CasaOS working." ;;
			health_title) echo "Disk health problem" ;;
			disk_watch) echo "Disk $1 shows the first signs of trouble: keep an eye on it and make sure you have backups." ;;
			disk_replace) echo "Disk $1 may fail soon: back up its data now and plan to replace it." ;;
			health_body) echo "Disk $1 reports a problem (SMART). Back up your data and check the disk." ;;
			temp_title) echo "Processor running hot" ;;
			temp_body) echo "The processor is at $1 °C. Check the cooling and what is running." ;;
			installed_title) echo "App installed" ;;
			installed_body) echo "$1 is installed." ;;
			removed_title) echo "App removed" ;;
			removed_body) echo "$1 was removed." ;;
			app_updated_title) echo "App updated" ;;
			app_updated_body) echo "$1 was updated." ;;
			queue_title) echo "During quiet hours" ;;
			queue_more) echo "… and $1 more." ;;
			down_title) echo "App down" ;;
			down_restarting) echo "$1 keeps restarting." ;;
			down_crashed) echo "$1 stopped on its own (exit code $2)." ;;
			down_unhealthy) echo "$1 reports it is not healthy (health check)." ;;
			down_no_answer) echo "$1 is running but its page does not answer." ;;
			up_title) echo "App working again" ;;
			up_body) echo "$1 is working again." ;;
			backup_title) echo "Automatic backup failed" ;;
			backup_body) echo "The automatic backup of $1 failed: $2" ;;
			auto_update_title) echo "Automatic update failed" ;;
			auto_update_body) echo "$1 was not updated automatically: $2" ;;
			update_title) echo "New Atrio version" ;;
			update_body) echo "Atrio $1 is available. Open Atrio's settings to update." ;;
		esac
	fi
}

# --- Sending -----------------------------------------------------------------------------------

LAST_SENT="" LAST_ERROR=""

# send TITLE MESSAGE PRIORITY(1-5) NTFY_TAGS
# Runs curl on a request; on failure leaves in $result what went wrong, with the server's own
# answer when there is one, so that a refusal reads as the reason instead of "error 400"
post() {
	local reply code
	reply=$(mktemp) || { result="Could not create a temporary file"; return 1; }
	code=$(curl -sS --connect-timeout 10 --max-time 20 -o "$reply" -w '%{http_code}' "$@" 2>"$reply.err")
	local status=$?
	if [ $status -eq 0 ] && [[ "$code" =~ ^2 ]]; then
		rm -f "$reply" "$reply.err"
		return 0
	fi
	if [ $status -ne 0 ]; then
		result=$(head -c 300 "$reply.err")
	else
		# Plain text, JSON or an HTML error page: tags removed, kept to one short line
		result="HTTP $code: $(head -c 4000 "$reply" | sed 's/<[^>]*>/ /g' | tr -s ' \t\r\n' ' ' | head -c 240)"
	fi
	rm -f "$reply" "$reply.err"
	return 1
}

# Whether now is within quiet hours, which can run past midnight
quiet_now() {
	[ "$QUIET" = 1 ] || return 1
	local now from to
	now=$((10#$(date +%H) * 60 + 10#$(date +%M)))
	from=$((10#${QUIET_FROM%:*} * 60 + 10#${QUIET_FROM#*:}))
	to=$((10#${QUIET_TO%:*} * 60 + 10#${QUIET_TO#*:}))
	if [ "$from" -le "$to" ]; then
		[ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]
	else
		[ "$now" -ge "$from" ] || [ "$now" -lt "$to" ]
	fi
}

muted() {
	[[ ",$MUTE," == *",$1,"* ]]
}

# send TITLE MESSAGE PRIORITY(1-5) NTFY_TAGS: in quiet hours, what is not urgent (below 5) waits
# in the queue and goes out as one message when they end
send() {
	if [ "${4:-}" != bell ] && [ "$3" -lt 5 ] && quiet_now; then
		printf '%s\t%s\n' "$1" "$2" | tr -d '\r' >> "$QUEUE"
		chmod 600 "$QUEUE" 2>/dev/null
		return 0
	fi
	send_now "$@"
}

# What waited during quiet hours, in one message
flush_queue() {
	[ -s "$QUEUE" ] && ! quiet_now || return 0
	local count body
	count=$(wc -l < "$QUEUE")
	body=$(head -n 15 "$QUEUE" | awk -F'\t' '{ print "• " $1 ": " $2 }')
	[ "$count" -gt 15 ] && body="$body
$(text queue_more $((count - 15)))"
	send_now "$(text queue_title)" "$body" 3 "zzz" && rm -f "$QUEUE"
}

send_now() {
	local title="$1" message="$2" priority="$3" tags="$4" result=""
	if [ "$SERVICE" = gotify ]; then
		post -F "title=$title" -F "message=$message" -F "priority=$priority" "$URL/message?token=$TOKEN"
	elif [ "$SERVICE" = apprise ]; then
		# Apprise API: the key names a saved configuration, whose services all get the message
		local type=info
		[ "$priority" -ge 4 ] && type=warning
		[ "$priority" -ge 5 ] && type=failure
		post -H "Accept: application/json" --data-urlencode "title=$title" --data-urlencode "body=$message" \
			--data-urlencode "type=$type" "$URL/notify/$TOPIC"
	else
		local auth=()
		[ -n "$TOKEN" ] && auth=(-H "Authorization: Bearer $TOKEN")
		# ntfy reads the title from a header: RFC 2047 keeps accents intact
		post "${auth[@]}" -H "Title: =?UTF-8?B?$(printf '%s' "$title" | base64 -w0)?=" \
			-H "Priority: $priority" -H "Tags: $tags" --data-binary "$message" "$URL/$TOPIC"
	fi
	if [ $? -eq 0 ]; then
		LAST_SENT="$title"
		return 0
	fi
	LAST_ERROR="${result:-Could not reach $URL}"
	return 1
}

# --- Checks ------------------------------------------------------------------------------------

check_disks() {
	local mount used
	while read -r used mount; do
		used="${used%\%}"
		[[ "$used" =~ ^[0-9]+$ ]] || continue
		local key="disk_$(printf '%s' "$mount" | tr -c 'A-Za-z0-9' '_')"
		if [ "$used" -ge "$DISK_LIMIT" ]; then
			[ "$(memory_get "$key")" = 1 ] && continue
			send "$(text disk_title)" "$(text disk_body "$mount" "$used")" 4 "warning" && memory_set "$key" 1
		elif [ "$used" -lt $((DISK_LIMIT - 5)) ]; then
			memory_set "$key" 0
		fi
	done < <(df -P -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs 2>/dev/null |
		awk 'NR > 1 && $6 !~ "^/(boot|snap)" { print $5, $6 }')
}

# --- Disk health --------------------------------------------------------------------------------

DISKS_JSON="$STATE/disks.json"
DISKS_TSV="$STATE/disks.tsv"
# Each disk's temperature at each hourly check, for a week: "time<tab>disk<tab>°C", the disk by its
# serial number (device names can change after a reboot)
DISKS_HISTORY="$STATE/history-disks.tsv"

# The SMART data of one disk as KEY=value lines, from smartctl's text output (ATA, SAT and NVMe)
smart_values() {
	awk '
		function num(s) { gsub(/,/, "", s); match(s, /^[0-9]+/); return RLENGTH > 0 ? substr(s, 1, RLENGTH) : "" }
		function after(s) { sub(/^[^:]*:[ \t]*/, "", s); return s }
		/^(Device Model|Model Number):/ { model = after($0) }
		/^Model Family:/ { family = after($0) }
		/^Serial Number:/ { serial = after($0) }
		/^(User Capacity|Total NVM Capacity|Namespace 1 Size\/Capacity):/ && !size { size = num(after($0)) }
		/^Rotation Rate:/ { kind = (after($0) ~ /Solid State/) ? "ssd" : "hdd" }
		/^SMART overall-health self-assessment test result:/ { health = after($0) }
		/^SMART Health Status:/ { health = after($0) }
		/^Critical Warning:/ { crit = after($0) }
		/^Temperature:/ { temp = num(after($0)) }
		/^Percentage Used:/ { used = num(after($0)) }
		/^Power On Hours:/ { hours = num(after($0)) }
		/^Media and Data Integrity Errors:/ { media = num(after($0)) }
		/^NVMe Version:|^Model Number:/ { kind = "nvme" }
		# Self-tests: whether the disk can run them, the one running now and the latest result
		/^Optional Admin Commands/ { selftest = ($0 ~ /Self_Test/) ? "yes" : "no" }
		/^[ \t]*Self-test supported\./ { selftest = "yes" }
		/No Self-test supported/ { selftest = "no" }
		/^Self-test execution status:/ { ata_status = ($0 ~ /in progress/) }
		ata_status && /% of test remaining/ { match($0, /[0-9]+%/); running = 100 - substr($0, RSTART, RLENGTH - 1); ata_status = 0 }
		/^Self-test status:/ && /in progress/ && !/No self-test/ { running = 0; if (match($0, /[0-9]+% completed/)) running = substr($0, RSTART, RLENGTH - 11) + 0 }
		/^Num  *Test_Description/ { in_log = 1; next }
		in_log && /^$/ { in_log = 0 }
		in_log && test == "" && (/^# *[0-9][0-9]* / || /^ *[0-9][0-9]* /) && !/in progress/ {
			row = $0
			sub(/^#? *[0-9][0-9]*  */, "", row)
			n = split(row, f, /   */)
			test_kind = (f[1] ~ /^Short/) ? "short" : (f[1] ~ /^Extended/) ? "long" : "other"
			test = (f[2] ~ /without error/) ? "passed" : (f[2] ~ /^(Aborted|Interrupted)/) ? "aborted" : "failed"
			for (i = 3; i <= n; i++) if (f[i] ~ /^[0-9]+$/) { test_hours = f[i]; break }
		}
		/^ID#  *ATTRIBUTE_NAME/ { in_attr = 1; next }
		in_attr && /^$/ { in_attr = 0 }
		# ATA attributes: ID NAME FLAG VALUE WORST THRESH TYPE UPDATED WHEN_FAILED RAW
		in_attr && $1 ~ /^[0-9]+$/ && NF >= 10 {
			raw = num($10)
			if ($1 == 5) realloc = raw
			else if ($1 == 9) hours = raw
			else if ($1 == 187 && unc == "") unc = raw
			else if ($1 == 188) timeout = raw
			else if ($1 == 194 || ($1 == 190 && temp == "")) temp = raw
			else if ($1 == 196 && realloc == "") realloc = raw
			else if ($1 == 197) pending = raw
			else if ($1 == 198) unc = raw
			else if ($1 == 199) crc = raw
			else if ($1 == 177 || $1 == 231 || $1 == 233) { if (used == "") used = 100 - num($4) }
			else if ($1 == 202) { if (used == "") used = raw }
		}
		END {
			if (model == "") model = family
			printf "MODEL=%s\nSERIAL=%s\nSIZE=%s\nKIND=%s\nHEALTH=%s\nCRIT=%s\nTEMP=%s\nUSED=%s\nHOURS=%s\n", model, serial, size, kind, health, crit, temp, used, hours
			printf "MEDIA=%s\nREALLOC=%s\nPENDING=%s\nUNC=%s\nCRC=%s\n", media, realloc, pending, unc, crc
			printf "SELFTEST=%s\nRUNNING=%s\nTEST=%s\nTESTKIND=%s\nTESTHOURS=%s\n", selftest, running, test, test_kind, test_hours
		}'
}

smart_get() {
	printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1
}

# good, watch or replace, then the reasons: the signs that, in Backblaze's statistics of their
# drives, go with a disk that fails soon (pending, uncorrectable and reallocated sectors), wear,
# and what is worth a look (cable errors, heat, age)
smart_verdict() {
	local v="$1" verdict=good reasons="" n
	add() { reasons="$reasons $1"; }
	n=$(smart_get "$v" HEALTH)
	[[ "$n" =~ FAIL ]] && { verdict=replace; add failed; }
	n=$(smart_get "$v" PENDING); [ "${n:-0}" -gt 0 ] && { verdict=replace; add pending; }
	n=$(smart_get "$v" UNC); [ "${n:-0}" -gt 0 ] && { verdict=replace; add uncorrectable; }
	n=$(smart_get "$v" MEDIA); [ "${n:-0}" -gt 0 ] && { verdict=replace; add media-errors; }
	[ "$(smart_get "$v" TEST)" = failed ] && { verdict=replace; add test-failed; }
	n=$(smart_get "$v" CRIT); [[ "$n" =~ ^0x0*[1-9a-fA-F] ]] && { verdict=replace; add critical-warning; }
	n=$(smart_get "$v" USED); [ "${n:-0}" -ge 100 ] && { verdict=replace; add worn-out; }
	n=$(smart_get "$v" REALLOC)
	if [ "${n:-0}" -ge 100 ]; then verdict=replace; add reallocated-many
	elif [ "${n:-0}" -gt 0 ]; then [ "$verdict" = good ] && verdict=watch; add reallocated
	fi
	n=$(smart_get "$v" USED); [ "${n:-0}" -ge 80 ] && [ "${n:-0}" -lt 100 ] && { [ "$verdict" = good ] && verdict=watch; add wearing; }
	# The counter never goes back to zero: only errors that came lately are worth a look
	[ "${CRC_RECENT:-0}" = 1 ] && { [ "$verdict" = good ] && verdict=watch; add cable; }
	local limit=55
	[ "$(smart_get "$v" KIND)" = nvme ] && limit=70
	n=$(smart_get "$v" TEMP); [ "${n:-0}" -ge "$limit" ] && { [ "$verdict" = good ] && verdict=watch; add hot; }
	[ "$(smart_get "$v" KIND)" = hdd ] && n=$(smart_get "$v" HOURS) && [ "${n:-0}" -ge 50000 ] && { [ "$verdict" = good ] && verdict=watch; add old; }
	[ -z "$(smart_get "$v" HEALTH)" ] && [ -z "$(smart_get "$v" TEMP)" ] && [ -z "$(smart_get "$v" HOURS)" ] && verdict=unknown
	printf '%s\t%s' "$verdict" "${reasons# }"
}

# Every hour: each disk smartctl can see, without waking one that sleeps (it keeps its last data).
# A verdict that gets worse is logged and sent; disks.json is what the hardware panel shows.
check_disk_health() {
	command -v smartctl >/dev/null || return 0
	local now last device type
	now=$(date +%s)
	last=$(memory_get disks_checked)
	# Once an hour; every 5 minutes while a self-test runs, so the panel follows it and shows the result
	DISKS_TIME=""
	if [ -n "$last" ] && [ $((now - last)) -lt 3600 ] && [ -f "$DISKS_JSON" ]; then
		[ "$(memory_get disks_testing)" = 1 ] || return 0
	else
		memory_set disks_checked "$now"
		# The temperature history keeps the hourly points only
		DISKS_TIME=$now
	fi
	touch "$DISKS_TSV"
	TESTING=0
	local present=" "
	while read -r device _ type _; do
		[[ "$device" =~ ^/dev/[A-Za-z0-9/_-]+$ ]] && [[ "$type" =~ ^[A-Za-z0-9,_+-]+$ ]] || continue
		# Asleep disks are still listed by the scan: they keep their last data below
		present+="$device "
		read_disk "$device" "$type" || continue
		[ -n "$(smart_get "$DISK_VALUES" RUNNING)" ] && TESTING=1
		[ "$SELFTEST" = 1 ] && schedule_selftest "$device" "$type"
	done < <(LC_ALL=C timeout 60 smartctl --scan-open 2>/dev/null | grep -v '^#')
	memory_set disks_testing "$TESTING"
	# A disk the scan no longer finds was unplugged: off the list. Not when the scan found nothing
	# at all, which is more likely smartctl failing than every disk gone.
	if [ "$present" != " " ]; then
		awk -F'\t' -v present="$present" 'index(present, " " $1 " ")' "$DISKS_TSV" > "$DISKS_TSV.tmp"
		mv "$DISKS_TSV.tmp" "$DISKS_TSV"
	fi
	if [ -f "$DISKS_HISTORY" ]; then
		keep_since "$DISKS_HISTORY" $((now - 7 * 86400))
		chmod 644 "$DISKS_HISTORY"
	fi
	write_disks
}

# Cable (CRC) errors add up for the whole life of a disk and never reset, so one old error would keep
# a disk on "keep an eye on it" forever. Remembered as "count time it last grew": 1 when it grew in
# the last week. Errors already there when Atrio first reads the disk count as old.
CRC_FRESH=$((7 * 86400))
crc_recent() {
	local count="$1" key="crc_$DISK_ID" stored now
	[[ "$count" =~ ^[0-9]+$ ]] || { echo 0; return; }
	now=$(date +%s)
	stored=$(memory_get "$key")
	if [ -z "$stored" ] || [ "$count" -lt "${stored%% *}" ]; then
		memory_set "$key" "$count 0"
	elif [ "$count" -gt "${stored%% *}" ]; then
		memory_set "$key" "$count $now"
	fi
	stored=$(memory_get "$key")
	local since="${stored##* }"
	[ "$since" -gt 0 ] && [ $((now - since)) -lt "$CRC_FRESH" ] && echo 1 || echo 0
}

# One disk: its SMART data and self-tests, the verdict, and its line in disks.tsv. Fails when it sleeps.
# DISK_VALUES and DISK_ID are left for the self-tests.
read_disk() {
	local device="$1" type="$2" out code values verdict reasons serial key before rank_new rank_old line seen result verdict_seen
	# WAKE=1 when asked from the panel: the test would wake the disk anyway
	local standby=(-n standby)
	[ "${WAKE:-0}" = 1 ] && standby=()
	# In C: in other languages smartctl writes 1.234 for 1,234 and the numbers would be cut
	out=$(LC_ALL=C timeout 60 smartctl "${standby[@]}" -i -H -A -c -l selftest -d "$type" "$device" 2>/dev/null)
	code=$?
	# Asleep: the data of the last check stay
	[ $((code & 2)) -ne 0 ] && printf '%s' "$out" | grep -qi standby && return 1
	values=$(printf '%s\n' "$out" | smart_values)
	serial=$(smart_get "$values" SERIAL)
	DISK_ID=$(printf '%s' "${serial:-$device}" | tr -c 'A-Za-z0-9' '_')
	CRC_RECENT=$(crc_recent "$(smart_get "$values" CRC)")
	line=$(smart_verdict "$values")
	verdict="${line%%$'\t'*}"
	reasons="${line#*$'\t'}"
	DISK_VALUES="$values"
	key="disk_verdict_$DISK_ID"
	before=$(memory_get "$key")
	# Read for the panel (--disk-test): a change stays new for the timer's next run, which logs it and
	# sends its alert. Taken here, it would never be sent (a disk that sleeps may not be read for days).
	[ "${PANEL_READ:-0}" = 1 ] && [ -n "$before" ] && verdict_seen="$before" || verdict_seen="$verdict"
	memory_set "$key" "$verdict_seen"
	rank_new=$(case "$verdict_seen" in watch) echo 1 ;; replace) echo 2 ;; *) echo 0 ;; esac)
	rank_old=$(case "$before" in watch) echo 1 ;; replace) echo 2 ;; *) echo 0 ;; esac)
	if [ -n "$before" ] && [ "$rank_new" -gt "$rank_old" ]; then
		log_activity disk-health error "" "$verdict $device $reasons"
		if [ "${SEND_HEALTH:-1}" = 1 ]; then
			send "$(text health_title)" "$(text "disk_$verdict" "$device ($(smart_get "$values" MODEL))")" "$([ "$verdict" = replace ] && echo 5 || echo 4)" "rotating_light"
		fi
	fi
	# Only on the hourly check, so the points are evenly spaced
	line=$(smart_get "$values" TEMP)
	if [ -n "${DISKS_TIME:-}" ] && [[ "$line" =~ ^[0-9]+$ ]]; then
		printf '%s\t%s\t%s\n' "$DISKS_TIME" "$DISK_ID" "$line" >> "$DISKS_HISTORY"
	fi
	# A self-test that finished since the last look goes to the activity log (a failed one also
	# turns the verdict to replace, which sends the alert above)
	result=$(smart_get "$values" TEST)
	if [ -n "$result" ]; then
		line="$(smart_get "$values" TESTKIND) $(smart_get "$values" TESTHOURS) $result"
		seen=$(memory_get "test_seen_$DISK_ID")
		memory_set "test_seen_$DISK_ID" "$line"
		if [ -n "$seen" ] && [ "$seen" != "$line" ]; then
			log_activity disk-test "$([ "$result" = failed ] && echo error || echo ok)" "" "$(smart_get "$values" TESTKIND) $result $device"
		fi
	fi
	{
		awk -F'\t' -v d="$device" '$1 != d' "$DISKS_TSV"
		# "-" for no reasons: read splits on tabs and would skip an empty field
		printf '%s\t%s\t%s\t%s\t%s\n' "$device" "$verdict" "${reasons:--}" "$(date -Iseconds)" "$(printf '%s' "$values" | tr '\n' '|')"
	} > "$DISKS_TSV.tmp"
	mv "$DISKS_TSV.tmp" "$DISKS_TSV"
}

# Self-tests the disk runs on its own while it keeps working: a short one (a couple of minutes) each
# week and a long one (a full read, hours on a big disk) each month, at night when possible. The
# first long test comes a week after Atrio first sees the disk, not on every disk on day one.
SHORT_EVERY=$((7 * 86400)) LONG_EVERY=$((30 * 86400))
schedule_selftest() {
	local device="$1" type="$2" now hour short long kind="" every last late
	[ "$(smart_get "$DISK_VALUES" SELFTEST)" = yes ] || return 0
	[ -z "$(smart_get "$DISK_VALUES" RUNNING)" ] || return 0
	now=$(date +%s)
	hour=${ATRIO_HOUR:-$(date +%-H)}
	short=$(memory_get "test_short_$DISK_ID")
	long=$(memory_get "test_long_$DISK_ID")
	# A disk seen for the first time gets its first short test the next night, not right away
	if [ -z "$short" ]; then
		short=$((now - SHORT_EVERY))
		memory_set "test_short_$DISK_ID" "$short"
	fi
	if [ -z "$long" ]; then
		long=$((now - LONG_EVERY + 7 * 86400))
		memory_set "test_long_$DISK_ID" "$long"
	fi
	if [ $((now - long)) -ge "$LONG_EVERY" ]; then
		kind=long every=$LONG_EVERY last=$long
	elif [ -z "$short" ] || [ $((now - short)) -ge "$SHORT_EVERY" ]; then
		kind=short every=$SHORT_EVERY last=$short
	fi
	[ -n "$kind" ] || return 0
	# From 1 to 6 in the morning, or at any hour once two days late (a server off at night)
	late=0
	[ "$last" -gt 0 ] && [ $((now - last)) -ge $((every + 2 * 86400)) ] && late=1
	[ "$hour" -ge 1 ] && [ "$hour" -le 6 ] || [ "$late" = 1 ] || return 0
	start_selftest "$device" "$type" "$kind"
}

# Started both on schedule and from the hardware panel; remembered even when it fails, so a disk
# that refuses is not asked again every hour
start_selftest() {
	local device="$1" type="$2" kind="$3" now
	now=$(date +%s)
	memory_set "test_${kind}_$DISK_ID" "$now"
	# A long test reads everything a short one does
	[ "$kind" = long ] && memory_set "test_short_$DISK_ID" "$now"
	if LC_ALL=C timeout 60 smartctl -t "$kind" -d "$type" "$device" >/dev/null 2>&1; then
		TESTING=1
		memory_set disks_testing 1
		log_activity disk-test ok "" "$kind started $device"
		return 0
	fi
	log_activity disk-test error "" "$kind not-started $device"
	return 1
}

write_disks() {
	local device verdict reasons checked values first=1 field key value
	{
		printf '{"time":"%s","disks":[' "$(date -Iseconds)"
		while IFS=$'\t' read -r device verdict reasons checked values; do
			[ -n "$device" ] || continue
			[ "$first" = 1 ] || printf ','
			first=0
			[ "$reasons" = - ] && reasons=""
			printf '{"device":"%s","verdict":"%s","reasons":"%s","checked":"%s"' "$device" "$verdict" "$reasons" "$checked"
			IFS='|' read -ra fields <<< "$values"
			for field in "${fields[@]}"; do
				key="${field%%=*}"
				value="${field#*=}"
				[[ "$key" =~ ^[A-Z]+$ ]] || continue
				printf ',"%s":"%s"' "$(printf '%s' "$key" | tr 'A-Z' 'a-z')" "$(json_text "$value")"
			done
			printf '}'
		done < "$DISKS_TSV"
		printf ']}\n'
	} > "$DISKS_JSON.tmp"
	chmod 644 "$DISKS_JSON.tmp"
	mv "$DISKS_JSON.tmp" "$DISKS_JSON"
}

cpu_temperature() {
	local hwmon best=0 value name
	for hwmon in "$SYS"/class/hwmon/hwmon*; do
		name=$(cat "$hwmon/name" 2>/dev/null) || continue
		case "$name" in coretemp* | k10temp* | zenpower* | cpu_thermal* | soc_thermal*) ;; *) continue ;; esac
		for value in "$hwmon"/temp*_input; do
			value=$(cat "$value" 2>/dev/null) || continue
			[[ "$value" =~ ^[0-9]+$ ]] && [ "$value" -gt "$best" ] && best="$value"
		done
	done
	echo $((best / 1000))
}

check_temperature() {
	local temp
	temp=$(cpu_temperature)
	[ "$temp" -gt 0 ] || return 0
	if [ "$temp" -ge "$TEMP_LIMIT" ]; then
		[ "$(memory_get temp)" = 1 ] && return 0
		send "$(text temp_title)" "$(text temp_body "$temp")" 4 "fire" && memory_set temp 1
	elif [ "$temp" -lt $((TEMP_LIMIT - 10)) ]; then
		memory_set temp 0
	fi
}

# The name an app shows in CasaOS: x-casaos > title > en_us in its compose file
app_title() {
	local file="$APPS/$1/docker-compose.yml" title
	title=$(awk '/^x-casaos:/ { x = 1; next } /^[^ ]/ { x = 0 }
		x && /^  title:/ { t = 1; next } x && /^  [^ ]/ { t = 0 }
		t && /en_us:/ { sub(/^[^:]*: */, ""); gsub(/"/, ""); print; exit }' "$file" 2>/dev/null)
	echo "${title:-$1}"
}

check_apps() {
	[ -d "$APPS" ] || return 0
	local now before name
	now=$(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tr '\n' ' ')
	before=$(memory_get apps)
	memory_set apps "$now"
	# The first run only takes note of what is installed; runs with app alerts off only log
	[ -n "$before" ] || return 0
	for name in $now; do
		[[ " $before " == *" $name "* ]] && continue
		log_activity app-installed ok "$name" ""
		[ "${SEND_APPS:-1}" = 1 ] && ! muted "$name" && send "$(text installed_title)" "$(text installed_body "$(app_title "$name")")" 3 "white_check_mark"
	done
	for name in $before; do
		[[ " $now " == *" $name "* ]] && continue
		log_activity app-removed ok "$name" ""
		[ "${SEND_APPS:-1}" = 1 ] && ! muted "$name" && send "$(text removed_title)" "$(text removed_body "$name")" 2 "wastebasket"
	done
}

# One service=image id for each running container of an app
app_images() {
	local ids
	ids=$(timeout 20 docker ps -q --filter "label=com.docker.compose.project=$1" 2>/dev/null)
	[ -n "$ids" ] || return 0
	timeout 20 docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}={{.Image}}' $ids 2>/dev/null |
		sort | tr '\n' ' '
}

# Whether a service in both lists runs another image: the tag alone says nothing for "latest"
images_changed() {
	local old new
	for new in $2; do
		for old in $1; do
			[ "${old%%=*}" = "${new%%=*}" ] && [ "$old" != "$new" ] && return 0
		done
	done
	return 1
}

check_app_updates() {
	command -v docker >/dev/null && [ -d "$APPS" ] || return 0
	local name now before
	for name in $(sed -n 's/^image_\([^=]*\)=.*/\1/p' "$MEMORY" 2>/dev/null); do
		# A removed app that comes back is an install, not an update
		[ -d "$APPS/$name" ] || sed -i "/^image_$name=/d" "$MEMORY"
	done
	for name in $(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'); do
		[[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || continue
		# A stopped app keeps what it ran before: an update made meanwhile shows when it starts
		now=$(app_images "$name")
		[ -n "$now" ] || continue
		before=$(memory_get "image_$name")
		if images_changed "$before" "$now"; then
			# Once per change, also when the alert has to be tried again
			if [ "$(memory_get "logged_$name")" != "$now" ]; then
				recently_updated_here "$name" || log_activity app-updated ok "$name" ""
				memory_set "logged_$name" "$now"
			fi
			if [ "${SEND_APPS:-1}" = 1 ] && ! muted "$name"; then
				send "$(text app_updated_title)" "$(text app_updated_body "$(app_title "$name")")" 3 "arrow_up" || continue
			fi
		fi
		memory_set "image_$name" "$now"
	done
}

# --- History -----------------------------------------------------------------------------------

# One sample every run (5 minutes) for the charts of the hardware panel, kept for 7 days:
# "time cpu% memory% load download upload cpu°C disk°C", CPU and memory in tenths of a percent,
# network in bytes per second averaged over the 5 minutes. Apps (CPU and memory each) for 24 hours.
HISTORY="$STATE/history.tsv"
APPS_HISTORY="$STATE/history-apps.tsv"

record_history() {
	local now line user nice system idle iowait irq softirq steal total busy previous cpu="" total_mem available mem=""
	local load rx=0 tx=0 iface down="" up="" since temp disk_temp=""
	now=$(date +%s)
	read -r _ user nice system idle iowait irq softirq steal _ < "$PROC/stat" || return 0
	total=$((user + nice + system + idle + iowait + irq + softirq + steal))
	busy=$((total - idle - iowait))
	previous=$(memory_get history_cpu)
	if [ -n "$previous" ] && [ "$total" -gt "${previous%% *}" ]; then
		cpu=$(( (busy - ${previous##* }) * 1000 / (total - ${previous%% *}) ))
	fi
	memory_set history_cpu "$total $busy"
	total_mem=$(awk '/^MemTotal:/ { print $2 }' "$PROC/meminfo")
	available=$(awk '/^MemAvailable:/ { print $2 }' "$PROC/meminfo")
	[ -n "$total_mem" ] && [ "$total_mem" -gt 0 ] && mem=$(( (total_mem - available) * 1000 / total_mem ))
	load=$(cut -d' ' -f1 "$PROC/loadavg" 2>/dev/null)
	# Real network cards only: Docker's bridges and veths would count the same bytes twice
	for iface in "$SYS"/class/net/*; do
		[ -e "$iface/device" ] || continue
		rx=$((rx + $(cat "$iface/statistics/rx_bytes" 2>/dev/null || echo 0)))
		tx=$((tx + $(cat "$iface/statistics/tx_bytes" 2>/dev/null || echo 0)))
	done
	previous=$(memory_get history_net)
	if [ -n "$previous" ]; then
		read -r since line <<< "$previous"
		local prx="${line%% *}" ptx="${line##* }"
		if [ "$now" -gt "$since" ] && [ "$rx" -ge "$prx" ] && [ "$tx" -ge "$ptx" ]; then
			down=$(( (rx - prx) / (now - since) ))
			up=$(( (tx - ptx) / (now - since) ))
		fi
	fi
	memory_set history_net "$now $rx $tx"
	temp=$(cpu_temperature)
	[ "${temp:-0}" -gt 0 ] || temp=""
	[ -f "$DISKS_TSV" ] && disk_temp=$(sed -n 's/.*|TEMP=\([0-9]*\)|.*/\1/p' "$DISKS_TSV" | sort -n | tail -n 1)
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$now" "$cpu" "$mem" "$load" "$down" "$up" "$temp" "$disk_temp" >> "$HISTORY"
	keep_since "$HISTORY" $((now - 7 * 86400))
	record_apps "$now"
}

# Bytes received and sent by each app since its containers started, exact, from the network of
# each container (/proc/<pid>/net/dev, the loopback left out): "app received sent" lines, and
# "app host" for an app on the host's network, which has no counters of its own
app_net_counters() {
	local id pid mode app ids
	ids=$(timeout 20 docker ps -q 2>/dev/null)
	[ -n "$ids" ] || return 0
	# shellcheck disable=SC2086
	timeout 20 docker inspect -f '{{.State.Pid}} {{.HostConfig.NetworkMode}} {{index .Config.Labels "com.docker.compose.project"}}' $ids 2>/dev/null |
		while read -r pid mode app; do
			[ -n "$app" ] && [[ "$pid" =~ ^[0-9]+$ ]] || continue
			if [ "$mode" = host ]; then
				echo "$app host"
			elif [[ "$mode" == container:* ]]; then
				# It shares another container's network (network_mode: service:...): counted there
				continue
			else
				awk -v app="$app" 'NR > 2 { sub(/^ */, ""); split($0, f, /[: ]+/); if (f[1] != "lo") { rx += f[2]; tx += f[10] } } END { printf "%s %.0f %.0f\n", app, rx, tx }' "$PROC/$pid/net/dev" 2>/dev/null
			fi
		done | LC_ALL=C awk '$2 == "host" { host[$1] = 1; next } { rx[$1] += $2; tx[$1] += $3 } END { for (a in host) print a, "host"; for (a in rx) if (!(a in host)) printf "%s %.0f %.0f\n", a, rx[a], tx[a] }'
}

# Bytes of the TCP connections in the server's own network, by who owns them: apps on the host's
# network (their containers) and the server's services (their systemd unit). One line per
# connection, "owner key received sent", where owner is app:<name> or svc:<unit> and key tells the
# connection apart. Connections inside the server only (loopback) and Docker's own are left out.
host_sockets() {
	command -v ss >/dev/null || return 0
	local lines pid cgroup owner ids id
	lines=$(LC_ALL=C timeout 20 ss -tinpH 2>/dev/null | LC_ALL=C awk '
		/^[A-Z]/ {
			local = $4; peer = $5; pid = ""
			if (match($0, /pid=[0-9]+/)) pid = substr($0, RSTART + 4, RLENGTH - 4)
			next
		}
		pid != "" && local !~ /^(127\.|\[::1\]|\[::ffff:127\.)/ {
			rx = 0; tx = 0
			if (match($0, /bytes_received:[0-9]+/)) rx = substr($0, RSTART + 15, RLENGTH - 15)
			if (match($0, /bytes_acked:[0-9]+/)) tx = substr($0, RSTART + 12, RLENGTH - 12)
			print pid, local "-" peer, rx, tx
			pid = ""
		}')
	[ -n "$lines" ] || return 0
	# Who owns each process: a container (then its app) or a systemd unit
	declare -A owners=()
	for pid in $(printf '%s\n' "$lines" | cut -d' ' -f1 | sort -u); do
		cgroup=$(sed -n 's/^0:://p' "$PROC/$pid/cgroup" 2>/dev/null | head -n 1)
		case "$cgroup" in
			*/docker-*.scope) id="${cgroup##*/docker-}"; owners[$pid]="container:${id%.scope}" ;;
			*/docker/*) owners[$pid]="container:${cgroup##*/docker/}" ;;
			*/docker.service|*/containerd.service|*/user.slice/*|"") ;;
			*.service) owner="${cgroup##*/}"; owner="${owner%.service}"; [[ "$owner" == casaos* ]] && owner=casaos; owners[$pid]="svc:$owner" ;;
		esac
	done
	# Containers to their apps
	ids=$(printf '%s\n' "${owners[@]}" | sed -n 's/^container://p' | sort -u)
	declare -A apps=()
	if [ -n "$ids" ]; then
		while read -r id app; do
			[ -n "$app" ] && apps[$id]="$app"
		# shellcheck disable=SC2086
		done < <(timeout 20 docker inspect -f '{{.Id}} {{index .Config.Labels "com.docker.compose.project"}}' $ids 2>/dev/null)
	fi
	printf '%s\n' "$lines" | while read -r pid key rx tx; do
		owner="${owners[$pid]:-}"
		case "$owner" in
			container:*) owner="${apps[${owner#container:}]:-}"; [ -n "$owner" ] && owner="app:$owner" ;;
		esac
		[ -n "$owner" ] && printf '%s %s %s %s\n' "$owner" "$key" "$rx" "$tx"
	done
}

# Bytes per owner between two host_sockets snapshots: a connection in both counts the difference,
# a new one all its bytes (it opened in between). "owner received sent" lines.
socket_delta() {
	LC_ALL=C awk -v before="$1" '
		BEGIN { n = split(before, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, " "); if (f[2] != "") { brx[f[1] " " f[2]] = f[3]; btx[f[1] " " f[2]] = f[4] } } }
		NF == 4 {
			k = $1 " " $2; rx = $3; tx = $4
			if (k in brx) { if (rx >= brx[k]) rx -= brx[k]; if (tx >= btx[k]) tx -= btx[k] }
			down[$1] += rx; up[$1] += tx
		}
		END { for (o in down) printf "%s %.0f %.0f\n", o, down[o], up[o] }' <<< "$2"
}

# CPU and memory of each app, from docker stats, summed over its containers, and its network
# averaged since the last run: "time app cpu% memoryMiB received/s sent/s", "-" on the host's network
record_apps() {
	command -v docker >/dev/null || return 0
	local now="$1" projects counters previous
	projects=$(timeout 20 docker ps --format '{{.ID}}	{{.Label "com.docker.compose.project"}}' 2>/dev/null)
	[ -n "$projects" ] || return 0
	counters=$(app_net_counters)
	previous=$(memory_get apps_net)
	# Apps on the host's network and the server's services: their connections since the last run
	local sockets before_sockets then delta
	sockets=$(host_sockets)
	before_sockets=$(cat "$STATE/net-sockets" 2>/dev/null)
	then=$(memory_get sockets_time)
	delta=""
	# None read (ss failed, or no connection at all): the last snapshot stays, so the next run counts
	# from it instead of taking every byte of the connections as new
	if [ -n "$sockets" ]; then
		printf '%s\n' "$sockets" > "$STATE/net-sockets"
		chmod 600 "$STATE/net-sockets"
		memory_set sockets_time "$now"
	else
		then=""
	fi
	[ -n "$then" ] && [ "$now" -gt "$then" ] && delta=$(socket_delta "$before_sockets" "$sockets" | awk -v s=$((now - then)) '{ printf "%s %.0f %.0f\n", $1, $2 / s, $3 / s }')
	memory_set apps_net "$now $(printf '%s' "$counters" | grep -v ' host$' | tr ' \n' ': ')"
	# In C: in other languages awk reads 12.5 as 12 and writes 12,5
	timeout 30 docker stats --no-stream --format '{{.ID}}	{{.CPUPerc}}	{{.MemUsage}}' 2>/dev/null | LC_ALL=C awk -F'\t' -v now="$now" -v projects="$projects" -v counters="$counters" -v previous="$previous" -v delta="$delta" '
		BEGIN {
			n = split(projects, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, "\t"); app[f[1]] = f[2] }
			n = split(counters, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, " "); if (f[2] == "host") host[f[1]] = 1; else { rx[f[1]] = f[2]; tx[f[1]] = f[3] } }
			# The counters of the last run: "time app:received:sent app:received:sent ..."
			m = split(previous, p, " "); then = p[1] + 0
			for (i = 2; i <= m; i++) { split(p[i], q, ":"); before_rx[q[1]] = q[2]; before_tx[q[1]] = q[3] }
			# Rates of the host-network apps and services, from their connections
			n = split(delta, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, " "); if (f[1] != "") { sock_rx[f[1]] = f[2]; sock_tx[f[1]] = f[3] } }
		}
		function mib(s,   v) { v = s + 0; if (s ~ /GiB/) v *= 1024; else if (s ~ /KiB/) v /= 1024; else if (s ~ /[0-9]B/ && s !~ /iB/) v /= 1048576; return v }
		{
			name = app[$1]; if (name == "") next
			cpu[name] += $2 + 0
			split($3, used, " / "); mem[name] += mib(used[1])
		}
		END {
			for (name in cpu) {
				down = ""; up = ""
				if (host[name]) { down = ("app:" name in sock_rx) ? sock_rx["app:" name] : (delta == "" ? "" : 0); up = ("app:" name in sock_tx) ? sock_tx["app:" name] : (delta == "" ? "" : 0) }
				# Counters start again when a container is recreated: no rate then
				else if ((name in before_rx) && (name in rx) && now > then && rx[name] >= before_rx[name] && tx[name] >= before_tx[name]) {
					down = sprintf("%.0f", (rx[name] - before_rx[name]) / (now - then)); up = sprintf("%.0f", (tx[name] - before_tx[name]) / (now - then))
				}
				printf "%s\t%s\t%.1f\t%.0f\t%s\t%s\n", now, name, cpu[name], mem[name], down, up
			}
			# The server'"'"'s services, by their unit: "svc:<unit>", with no CPU or memory here
			for (o in sock_rx) if (o ~ /^svc:/) printf "%s\t%s\t\t\t%s\t%s\n", now, o, sock_rx[o], sock_tx[o]
		}' >> "$APPS_HISTORY"
	keep_since "$APPS_HISTORY" $((now - 86400))
	chmod 644 "$HISTORY" "$APPS_HISTORY" 2>/dev/null
}

# Network now, for the network detail: each app and the whole server measured twice, a few
# seconds apart, into network.json. Run with --network, by atrio-backup when the web UI asks.
measure_network() {
	local first second t1 t2 server1 server2 iface rx tx
	server_bytes() {
		rx=0; tx=0
		for iface in "$SYS"/class/net/*; do
			[ -e "$iface/device" ] || continue
			rx=$((rx + $(cat "$iface/statistics/rx_bytes" 2>/dev/null || echo 0)))
			tx=$((tx + $(cat "$iface/statistics/tx_bytes" 2>/dev/null || echo 0)))
		done
		echo "$rx $tx"
	}
	local sockets1 sockets2 delta
	t1=$(date +%s%N); first=$(app_net_counters); server1=$(server_bytes); sockets1=$(host_sockets)
	sleep "${ATRIO_NETWORK_WAIT:-3}"
	t2=$(date +%s%N); second=$(app_net_counters); server2=$(server_bytes); sockets2=$(host_sockets)
	delta=$(socket_delta "$sockets1" "$sockets2")
	LC_ALL=C awk -v ms=$(( (t2 - t1) / 1000000 )) -v first="$first" -v second="$second" -v s1="$server1" -v s2="$server2" -v delta="$delta" -v time="$(date -Iseconds)" '
		BEGIN {
			seconds = ms / 1000; if (seconds <= 0) seconds = 1
			n = split(first, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, " "); a_rx[f[1]] = f[2]; a_tx[f[1]] = f[3] }
			split(s1, x, " "); split(s2, y, " ")
			n = split(delta, rows, "\n"); for (i = 1; i <= n; i++) { split(rows[i], f, " "); if (f[1] != "") { sock_rx[f[1]] = f[2]; sock_tx[f[1]] = f[3] } }
			printf "{\"time\":\"%s\",\"server\":{\"down\":%.0f,\"up\":%.0f},\"apps\":[", time, (y[1] - x[1]) / seconds, (y[2] - x[2]) / seconds
			n = split(second, rows, "\n"); sep = ""
			for (i = 1; i <= n; i++) {
				split(rows[i], f, " "); if (f[1] == "") continue
				if (f[2] == "host") { printf "%s{\"app\":\"%s\",\"host\":true,\"down\":%.0f,\"up\":%.0f}", sep, f[1], sock_rx["app:" f[1]] / seconds, sock_tx["app:" f[1]] / seconds; sep = ","; continue }
				if (!(f[1] in a_rx) || f[2] < a_rx[f[1]] || f[3] < a_tx[f[1]]) continue
				printf "%s{\"app\":\"%s\",\"down\":%.0f,\"up\":%.0f}", sep, f[1], (f[2] - a_rx[f[1]]) / seconds, (f[3] - a_tx[f[1]]) / seconds; sep = ","
			}
			printf "],\"services\":["; sep = ""
			for (o in sock_rx) if (o ~ /^svc:/) { printf "%s{\"name\":\"%s\",\"down\":%.0f,\"up\":%.0f}", sep, substr(o, 5), sock_rx[o] / seconds, sock_tx[o] / seconds; sep = "," }
			print "]}"
		}' > "$STATE/network.json.tmp"
	chmod 644 "$STATE/network.json.tmp"
	mv "$STATE/network.json.tmp" "$STATE/network.json"
}

# Drops the lines of a history file older than $2 (first column, seconds)
keep_since() {
	awk -F'\t' -v since="$2" '$1 >= since' "$1" > "$1.tmp" && mv "$1.tmp" "$1"
}

# --- App health ---------------------------------------------------------------------------------

HEALTH_JSON="$STATE/health.json"

# A value from the x-casaos block of an app's compose file (port_map, scheme, index)
xcasaos() {
	awk -v key="$2" '
		/^x-casaos:/ { x = 1; level = -1; next }
		/^[^ ]/ { x = 0 }
		x && /^ +[^ ]/ {
			match($0, /^ */); n = RLENGTH
			if (level < 0) level = n
			if (n == level && index($0, key ":") == n + 1) {
				value = substr($0, n + length(key) + 2); gsub(/^ +| +$|["'"'"']/, "", value); print value; exit
			}
		}' "$APPS/$1/docker-compose.yml" 2>/dev/null
}

# How an app is doing: ok, stopped (by someone), restarting, crashed, unhealthy or no-answer,
# then a tab and a detail (the exit code of a crash)
app_condition() {
	local app="$1" ids line status code oom health restarts name stopped=0 running=0 total=0 before port scheme index url answer
	ids=$(timeout 20 docker ps -aq --filter "label=com.docker.compose.project=$app" 2>/dev/null)
	[ -n "$ids" ] || { printf 'none	'; return; }
	local all_restarts=0
	while read -r status code oom health restarts name; do
		[ -n "$status" ] || continue
		total=$((total + 1))
		all_restarts=$((all_restarts + ${restarts:-0}))
		case "$status" in
			restarting) printf 'restarting	'; return ;;
			running)
				running=$((running + 1))
				[ "$health" = unhealthy ] && { printf 'unhealthy	'; return; } ;;
			exited|dead)
				if [ "$oom" = true ] || ! [[ "$code" =~ ^(0|137|143)$ ]]; then
					printf 'crashed	%s' "$code"
					return
				fi
				stopped=$((stopped + 1)) ;;
		esac
	# shellcheck disable=SC2086
	done < <(timeout 20 docker inspect -f '{{.State.Status}} {{.State.ExitCode}} {{.State.OOMKilled}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.RestartCount}} {{.Name}}' $ids 2>/dev/null)
	# Restarted again and again between two checks, even if it happens to be up right now
	before=$(memory_get "app_restarts_$app")
	memory_set "app_restarts_$app" "$all_restarts"
	if [ -n "$before" ] && [ $((all_restarts - before)) -ge 3 ]; then
		printf 'restarting	'
		return
	fi
	[ "$stopped" -eq "$total" ] && { printf 'stopped	'; return; }
	# Running: its page must answer, with anything (a login page, a 404 are fine)
	port=$(xcasaos "$app" port_map)
	if [ "$running" -eq "$total" ] && [[ "$port" =~ ^[0-9]{1,5}$ ]]; then
		scheme=$(xcasaos "$app" scheme)
		[[ "$scheme" =~ ^https?$ ]] || scheme=http
		url="$scheme://127.0.0.1:$port/"
		answer=$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 5 --max-time 15 "$url" 2>/dev/null)
		[ "${answer:-000}" = 000 ] && { printf 'no-answer	'; return; }
	fi
	printf 'ok	'
}

# Every installed app; a problem counts once it is seen twice in a row (ten minutes), so that a
# restart or an update is not taken for one. Skipped while atrio-backup stops apps on purpose.
check_app_health() {
	command -v docker >/dev/null && [ -d "$APPS" ] || return 0
	if [ -f "$STATE/backup.lock" ] && ! flock -n "$STATE/backup.lock" true 2>/dev/null; then
		return 0
	fi
	local app line condition detail shown count first=1 since title
	{
		printf '{"time":"%s","apps":{' "$(date -Iseconds)"
		for app in $(find "$APPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort); do
			[[ "$app" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [ -f "$APPS/$app/docker-compose.yml" ] || continue
			line=$(app_condition "$app")
			condition="${line%%$'\t'*}"
			detail="${line#*$'\t'}"
			[ "$condition" = none ] && continue
			shown=$(memory_get "app_state_$app")
			case "$condition" in
				ok|stopped)
					memory_set "app_bad_$app" 0
					if [ -n "$shown" ] && [ "$shown" != ok ] && [ "$shown" != stopped ]; then
						log_activity app-up ok "$app" ""
						[ "${SEND_DOWN:-1}" = 1 ] && ! muted "$app" && send "$(text up_title)" "$(text up_body "$(app_title "$app")")" 3 "white_check_mark"
					fi
					shown="$condition"
					memory_set "app_since_$app" "$(date -Iseconds)" ;;
				*)
					count=$(( $(memory_get "app_bad_$app" || echo 0) + 1 ))
					memory_set "app_bad_$app" "$count"
					if [ "$count" -ge 2 ] && [ "$shown" != "$condition" ]; then
						title=$(app_title "$app")
						log_activity app-down error "$app" "$condition $detail"
						if [ "${SEND_DOWN:-1}" = 1 ] && ! muted "$app"; then
							case "$condition" in
								restarting) send "$(text down_title)" "$(text down_restarting "$title")" 4 "warning" ;;
								crashed) send "$(text down_title)" "$(text down_crashed "$title" "$detail")" 4 "warning" ;;
								unhealthy) send "$(text down_title)" "$(text down_unhealthy "$title")" 4 "warning" ;;
								no-answer) send "$(text down_title)" "$(text down_no_answer "$title")" 4 "warning" ;;
							esac
						fi
						shown="$condition"
						memory_set "app_since_$app" "$(date -Iseconds)"
					fi
					# Until it counts, the tile keeps what it showed
					[ -n "$shown" ] || shown=ok ;;
			esac
			memory_set "app_state_$app" "$shown"
			[ "$first" = 1 ] || printf ','
			first=0
			printf '"%s":{"state":"%s","since":"%s","detail":"%s"}' "$app" "$shown" "$(memory_get "app_since_$app")" "$(json_text "$detail")"
		done
		printf '}}\n'
	} > "$HEALTH_JSON.tmp"
	chmod 644 "$HEALTH_JSON.tmp"
	mv "$HEALTH_JSON.tmp" "$HEALTH_JSON"
}

# Automatic backups that failed, each one once (atrio-backup writes the result in schedules/)
check_backups() {
	local file name error time
	for file in "$STATE/schedules"/*; do
		[ -f "$file" ] || continue
		name=$(basename "$file")
		[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [[ "$name" != *.tmp ]] || continue
		error=$(sed -n 's/^LAST_ERROR=//p' "$file" | head -n 1 | head -c 200)
		time=$(sed -n 's/^LAST_TIME=//p' "$file" | head -n 1)
		[ -n "$error" ] && [ -n "$time" ] || continue
		[ "$(memory_get "backup_$name")" = "$time" ] && continue
		send "$(text backup_title)" "$(text backup_body "$(app_title "$name")" "$error")" 4 "warning" && memory_set "backup_$name" "$time"
	done
	# Folder backups: the same alert, with the folder where the app would be
	for file in "$STATE/folder-jobs"/*; do
		[ -f "$file" ] || continue
		name=$(basename "$file")
		[[ "$name" =~ ^[a-f0-9]{12}$ ]] || continue
		error=$(sed -n 's/^LAST_ERROR=//p' "$file" | head -n 1 | head -c 200)
		time=$(sed -n 's/^LAST_TIME=//p' "$file" | head -n 1)
		[ -n "$error" ] && [ -n "$time" ] || continue
		[ "$(memory_get "folder_backup_$name")" = "$time" ] && continue
		send "$(text backup_title)" "$(text backup_body "$(sed -n 's/^PATH=//p' "$file" | head -n 1 | tr -d '\000-\037' | head -c 200)" "$error")" 4 "warning" \
			&& memory_set "folder_backup_$name" "$time"
	done
}

# Automatic updates that failed, each one once (atrio-backup writes the results)
check_auto_updates() {
	local name time result message
	[ -f "$STATE/auto-update-results" ] || return 0
	while IFS=$'\t' read -r name time result message _; do
		[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] && [ "$result" = error ] && [ -n "$time" ] || continue
		[ "$(memory_get "auto_update_$name")" = "$time" ] && continue
		send "$(text auto_update_title)" "$(text auto_update_body "$(app_title "$name")" "$(printf '%s' "$message" | head -c 200)")" 4 "warning" \
			&& memory_set "auto_update_$name" "$time"
	done < "$STATE/auto-update-results"
}

check_updates() {
	# GitHub is asked every 6 hours at most
	local last now latest installed
	last=$(memory_get update_checked)
	now=$(date +%s)
	[ -n "$last" ] && [ $((now - last)) -lt 21600 ] && return 0
	memory_set update_checked "$now"
	latest=$(curl -fsS --max-time 20 "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null |
		sed -n 's/.*"tag_name" *: *"v\{0,1\}\([^"]*\)".*/\1/p' | head -n 1)
	installed=$(sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' "$WWW/atrio-version.json" 2>/dev/null)
	[ -n "$latest" ] && [ -n "$installed" ] || return 0
	[ "$latest" = "$installed" ] && return 0
	# Only newer versions: the highest of the two must be the latest
	[ "$(printf '%s\n%s\n' "$installed" "$latest" | sort -V | tail -n 1)" = "$latest" ] || return 0
	[ "$(memory_get update_sent)" = "$latest" ] && return 0
	send "$(text update_title)" "$(text update_body "$latest")" 3 "arrow_up" && memory_set update_sent "$latest"
}

# --- Status for the settings -------------------------------------------------------------------

json_text() {
	printf '%s' "$1" | tr -d '"\\' | tr '\n\r\t' '   ' | cut -c1-200
}

write_status() {
	printf '{"state":"%s","message":"%s","last_sent":"%s","token":"%s","time":"%s"}\n' \
		"$1" "$(json_text "$2")" "$(json_text "$LAST_SENT")" "$REQUEST_TOKEN" "$(date -Iseconds)" > "$STATUS.tmp"
	mv "$STATUS.tmp" "$STATUS"
}

# --- Main --------------------------------------------------------------------------------------

configured() {
	if [ "$SERVICE" = gotify ]; then [ -n "$TOKEN" ]; else [ -n "$TOPIC" ]; fi
}

read_conf
REQUEST_TOKEN=""
trim_activity

# From the hardware panel, through atrio-backup: a self-test now on one disk smartctl lists
if [ "$MODE" = "--disk-test" ]; then
	command -v smartctl >/dev/null || exit 1
	[[ "$3" =~ ^(short|long)$ ]] || exit 1
	# Alerts go out from the timer's runs, which know whether they are on and set up: a new verdict
	# read here is left for them (read_disk)
	SEND_HEALTH=0
	PANEL_READ=1
	while read -r device _ type _; do
		[ "$device" = "$2" ] && [[ "$type" =~ ^[A-Za-z0-9,_+-]+$ ]] || continue
		touch "$DISKS_TSV"
		WAKE=1 read_disk "$device" "$type" || exit 1
		# The panel then shows the test that is running
		[ -n "$(smart_get "$DISK_VALUES" RUNNING)" ] && { memory_set disks_testing 1; write_disks; exit 2; }
		start_selftest "$device" "$type" "$3" || exit 1
		# Read again so the panel shows it running
		sleep "${ATRIO_TEST_WAIT:-2}"
		WAKE=1 read_disk "$device" "$type"
		write_disks
		exit 0
	done < <(LC_ALL=C timeout 60 smartctl --scan-open 2>/dev/null | grep -v '^#')
	exit 1
fi

if [ "$MODE" = "--network" ]; then
	command -v docker >/dev/null && measure_network
	exit 0
fi

if [ "$MODE" = "--test" ]; then
	# The request carries a token so the settings recognise the answer to their own test
	[ -f "$TEST_REQUEST" ] && REQUEST_TOKEN=$(head -c 64 "$TEST_REQUEST" | tr -cd 'A-Za-z0-9-')
	rm -f "$TEST_REQUEST"
	if ! configured; then
		write_status error "Not set up yet"
		exit 1
	fi
	if send_now "$(text test_title)" "$(text test_body)" 3 "bell"; then
		write_status ok "Test sent"
	else
		write_status error "$LAST_ERROR"
		exit 1
	fi
	exit 0
fi

if [ "$ENABLED" != 1 ] || ! configured; then
	# Keep the app list current, so turning alerts on later does not announce every app or update
	record_history
	SEND_APPS=0 check_apps
	SEND_APPS=0 check_app_updates
	# The tiles show how apps are doing, and the hardware panel the disks, also with alerts off
	SEND_DOWN=0 check_app_health
	SEND_HEALTH=0 check_disk_health
	write_status disabled ""
	exit 0
fi

record_history
[ "$DISK" = 1 ] && check_disks
if [ "$HEALTH" = 1 ]; then check_disk_health; else SEND_HEALTH=0 check_disk_health; fi
[ "$TEMP" = 1 ] && check_temperature
if [ "$APPS_CHANGES" = 1 ]; then check_apps; else SEND_APPS=0 check_apps; fi
if [ "$APP_UPDATES" = 1 ]; then check_app_updates; else SEND_APPS=0 check_app_updates; fi
[ "$UPDATES" = 1 ] && check_updates
if [ "$APP_DOWN" = 1 ]; then check_app_health; else SEND_DOWN=0 check_app_health; fi
check_backups
check_auto_updates
flush_queue

if [ -n "$LAST_ERROR" ]; then
	write_status error "$LAST_ERROR"
else
	write_status ok ""
fi
